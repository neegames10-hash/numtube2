+#pragma once
+
+#include <apps/i18n.h>
+#include <escher/app.h>
+
+#include "chat_controller.h"
+
+namespace Numchat {
+
+class App : public Escher::App {
+ public:
+  class Descriptor : public Escher::App::Descriptor {
+   public:
+    I18n::Message name() const override { return I18n::Message::NumchatApp; }
+    I18n::Message upperName() const override {
+      return I18n::Message::NumchatAppCapital;
+    }
+    const Escher::Image* icon() const override;
+  };
+
+  class Snapshot : public Escher::App::Snapshot {
+   public:
+    App* unpack(Escher::Container* container) override;
+    const Descriptor* descriptor() const override;
+  };
+
+  void willBecomeInactive() override;
+  int numberOfTimers() override { return 1; }
+  Escher::Timer* timerAtIndex(int i) override { return &m_usbTimer; }
+
+ private:
+  // Starts the session once the app is on screen (every tick, 100 ms).
+  class UsbTimer : public Escher::Timer {
+   public:
+    explicit UsbTimer(ChatController* controller)
+        : Escher::Timer(1), m_controller(controller) {}
+
+   private:
+    bool fire() override {
+      m_controller->tick();
+      return false;
+    }
+    ChatController* m_controller;
+  };
+
+  App(Snapshot* snapshot);
+  ChatController m_controller;
+  UsbTimer m_usbTimer;
+};
+
+}  // namespace Numchat
diff --git a/epsilon/apps/numchat/chat_controller.cpp b/epsilon/apps/numchat/chat_controller.cpp
new file mode 100644
index 0000000000..2b70f466a0
--- /dev/null
+++ b/epsilon/apps/numchat/chat_controller.cpp
@@ -0,0 +1,635 @@
+#include "chat_controller.h"
+
+#include <apps/apps_container.h>
+#include <ion/display.h>
+#include <ion/events.h>
+#include <ion/timing.h>
+#include <ion/usb.h>
+#include <string.h>
+
+#include "protocol.h"
+
+namespace Numchat {
+
+using Numtube::KeyWatcher;
+using Ion::Keyboard::Key;
+
+namespace {
+
+constexpr uint32_t k_pingIntervalMs = 4000;
+// No frame at all from the gateway for this long: it is gone.
+constexpr uint32_t k_gatewayTimeoutMs = 13000;
+constexpr uint32_t k_sendTimeoutMs = 20000;
+
+void copyString(char* destination, size_t capacity, const char* source,
+                size_t length) {
+  size_t count = length < capacity - 1 ? length : capacity - 1;
+  // Never cut a UTF-8 sequence (or a letter from its accent) in two.
+  if (count < length) {
+    while (count > 0 &&
+           ((static_cast<uint8_t>(source[count]) & 0xC0) == 0x80 ||
+            static_cast<uint8_t>(source[count]) == 0xCC ||
+            static_cast<uint8_t>(source[count]) == 0xCD)) {
+      count--;
+    }
+  }
+  memcpy(destination, source, count);
+  destination[count] = '\0';
+}
+
+// Reads a str8 field. Returns false if the payload is too short.
+bool readString(const uint8_t* payload, uint16_t length, uint16_t* cursor,
+                char* destination, size_t capacity) {
+  if (*cursor >= length) {
+    destination[0] = '\0';
+    return false;
+  }
+  const uint8_t size = payload[(*cursor)++];
+  if (*cursor + size > length) {
+    destination[0] = '\0';
+    return false;
+  }
+  copyString(destination, capacity, reinterpret_cast<const char*>(payload + *cursor), size);
+  *cursor += size;
+  return true;
+}
+
+void setStatusBarModifiers(Ion::Events::ShiftAlphaStatus status) {
+  // Through the container so that the status bar indicator follows.
+  AppsContainer::sharedAppsContainer()->setShiftAlphaStatus(status);
+}
+
+bool isExitKey(Key key) { return key == Key::Home || key == Key::OnOff; }
+
+}  // namespace
+
+ChatController::ChatController(Escher::Responder* parentResponder)
+    : Escher::ViewController(parentResponder),
+      m_view(this),
+      m_screen(Screen::Start),
+      m_conversationCount(0),
+      m_pendingCount(0),
+      m_selection(0),
+      m_firstVisible(0),
+      m_messageStart(0),
+      m_messageCount(0),
+      m_scrollLines(0),
+      m_unseenBelow(false),
+      m_sending(false),
+      m_historyLoaded(false),
+      m_messageNeedsKey(false),
+      m_autoStart(true),
+      m_lastFrameTime(0),
+      m_lastPingTime(0),
+      m_sendStartTime(0),
+      m_viewing(false),
+      m_viewStillViewable(false),
+      m_mediaWidth(0),
+      m_mediaHeight(0),
+      m_viewStartTime(0),
+      m_viewTarget(-1),
+      m_emojiValid(0) {
+  m_message[0] = '\0';
+  m_status[0] = '\0';
+  m_openId[0] = '\0';
+  m_openName[0] = '\0';
+}
+
+void ChatController::viewWillAppear() { showStart(); }
+
+void ChatController::redraw(KDRect rect) {
+  m_view.redrawRect(rect);
+  AppsContainer::sharedAppsContainer()->redrawWindow();
+}
+
+void ChatController::redrawAll() { redraw(m_view.bounds()); }
+
+void ChatController::showStart() {
+  m_screen = Screen::Start;
+  m_messageNeedsKey = false;
+  m_view.redrawAll();
+}
+
+void ChatController::showMessage(const char* message, bool needsKey) {
+  copyString(m_message, sizeof(m_message), message, strlen(message));
+  m_screen = Screen::Message;
+  m_messageNeedsKey = needsKey;
+  redrawAll();
+}
+
+void ChatController::updateModifierIndicator() {
+  setStatusBarModifiers(m_input.modifiers());
+  redraw(ChatView::inputRect());
+}
+
+void ChatController::tick() {
+  // Connect as soon as the app is open (once: Back leaves to the start screen).
+  if (m_autoStart && m_screen == Screen::Start) {
+    m_autoStart = false;
+    runSession();
+  }
+}
+
+bool ChatController::ensureConnected() {
+  if (m_link.isConnected()) {
+    return true;
+  }
+  showMessage("Connexion au Mac...\nOuvre l'appli NumTube sur le Mac.\n\nRetour : annuler", false);
+  switch (m_link.connect()) {
+    case Numtube::Link::ConnectResult::Connected:
+      m_lastFrameTime = m_lastPingTime = Ion::Timing::millis();
+      return true;
+    case Numtube::Link::ConnectResult::Cancelled:
+      showStart();
+      return false;
+    case Numtube::Link::ConnectResult::NoCable:
+      showMessage("Branche la calculatrice au Mac avec le cable USB.", true);
+      return false;
+  }
+  return false;
+}
+
+bool ChatController::linkAlive() {
+  if (!Numtube::cablePlugged()) {
+    m_link.disconnect();
+    showMessage("Cable USB debranche.", true);
+    return false;
+  }
+  const uint64_t now = Ion::Timing::millis();
+  if (now - m_lastFrameTime > k_gatewayTimeoutMs) {
+    m_link.disconnect();
+    showMessage("Le Mac ne repond plus.\nL'appli NumTube est-elle ouverte ?", true);
+    return false;
+  }
+  if (now - m_lastPingTime > k_pingIntervalMs) {
+    m_lastPingTime = now;
+    m_link.send(Protocol::Ping, nullptr, 0);
+  }
+  return true;
+}
+
+/* While connected, the calculator never hands control back to Epsilon's event
+ * loop: idling there makes the USB port stop answering and the Mac drops the
+ * calculator a few seconds later. So the whole session (list, conversation,
+ * typing) runs in the loops below, and the link closes when it ends. */
+void ChatController::runSession() {
+  if (!ensureConnected()) {
+    return;
+  }
+  m_link.log("numchat: session");
+  m_emojiValid = 0;  // the gateway starts a new emoji table for each session
+  const bool lost = !browseList();
+  m_link.disconnect();
+  m_input.resetModifiers();
+  setStatusBarModifiers(Ion::Events::ShiftAlphaStatus());
+  if (!lost || m_screen != Screen::Message) {
+    showStart();
+  }
+  AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+  redrawAll();
+}
+
+bool ChatController::requestList() {
+  m_pendingCount = 0;
+  return m_link.send(Protocol::List, nullptr, 0);
+}
+
+void ChatController::handleConversationFrame(const uint8_t* payload, uint16_t length) {
+  if (length < 2) {
+    return;
+  }
+  const int index = payload[0];
+  if (index == 0) {
+    m_pendingCount = 0;
+  }
+  if (index != m_pendingCount || index >= k_maxConversations) {
+    return;
+  }
+  /* Entries are written in place: the list on screen briefly mixes old and
+   * new rows, which is fine since ListDone redraws it right after. */
+  ConversationEntry& c = m_conversations[index];
+  c.flags = payload[1];
+  uint16_t cursor = 2;
+  readString(payload, length, &cursor, c.id, sizeof(c.id));
+  readString(payload, length, &cursor, c.name, sizeof(c.name));
+  readString(payload, length, &cursor, c.preview, sizeof(c.preview));
+  m_pendingCount++;
+}
+
+void ChatController::handleMessageFrame(const uint8_t* payload, uint16_t length) {
+  if (length < 2) {
+    return;
+  }
+  const bool wasAtBottom = m_scrollLines == 0;
+  int slot;
+  if (m_messageCount < k_maxMessages) {
+    slot = (m_messageStart + m_messageCount) % k_maxMessages;
+    m_messageCount++;
+  } else {
+    // Full: forget the oldest message.
+    slot = m_messageStart;
+    m_messageStart = (m_messageStart + 1) % k_maxMessages;
+  }
+  ChatMessage& m = m_messages[slot];
+  m.flags = payload[0];
+  m.mediaId = 0;
+  uint16_t cursor = 1;
+  readString(payload, length, &cursor, m.sender, sizeof(m.sender));
+  if ((m.flags & Protocol::k_viewable) && cursor < length) {
+    m.mediaId = payload[cursor++];
+  }
+  copyString(m.text, sizeof(m.text), reinterpret_cast<const char*>(payload + cursor),
+             cursor < length ? length - cursor : 0);
+  if (m.text[0] == '\0') {
+    copyString(m.text, sizeof(m.text), " ", 1);
+  }
+  if (!wasAtBottom) {
+    // Keep the lines being read in place.
+    m_scrollLines += m_view.linesForMessage(m_messageCount - 1);
+    if (!(m.flags & Protocol::k_history)) {
+      m_unseenBelow = true;
+    }
+  }
+}
+
+/* Reads every frame waiting on the link. Returns true if something on screen
+ * changed. */
+bool ChatController::pollFrames(bool inConversation, bool* linkLost) {
+  bool changed = false;
+  uint8_t type;
+  const uint8_t* payload;
+  uint16_t length;
+  int budget = 16;  // stay responsive to the keyboard during a burst
+  while (budget-- > 0 && m_link.poll(&type, &payload, &length)) {
+    m_lastFrameTime = Ion::Timing::millis();
+    switch (type) {
+      case Protocol::Conversation:
+        handleConversationFrame(payload, length);
+        break;
+      case Protocol::ListDone:
+        m_conversationCount = m_pendingCount;
+        if (m_selection >= m_conversationCount) {
+          m_selection = m_conversationCount > 0 ? m_conversationCount - 1 : 0;
+        }
+        if (m_firstVisible > m_selection) {
+          m_firstVisible = m_selection;
+        }
+        changed = !inConversation;
+        break;
+      case Protocol::Message:
+        if (inConversation) {
+          handleMessageFrame(payload, length);
+          changed = true;
+        }
+        break;
+      case Protocol::OpenDone:
+        if (inConversation) {
+          m_historyLoaded = true;
+          changed = true;
+        }
+        break;
+      case Protocol::SendResult:
+        if (inConversation && m_sending) {
+          m_sending = false;
+          if (length >= 1 && payload[0] == 1) {
+            m_input.clear();
+            copyString(m_status, sizeof(m_status), "", 0);
+          } else {
+            copyString(m_status, sizeof(m_status),
+                       length > 1 ? reinterpret_cast<const char*>(payload + 1) : "Envoi impossible",
+                       length > 1 ? length - 1 : strlen("Envoi impossible"));
+          }
+          changed = true;
+        }
+        break;
+      case Protocol::Status:
+        copyString(m_status, sizeof(m_status), reinterpret_cast<const char*>(payload), length);
+        changed = !m_viewing;
+        break;
+      case Protocol::Emoji:
+        handleEmojiFrame(payload, length);
+        changed = !m_viewing;
+        break;
+      case Protocol::MediaStart:
+        if (m_viewing && length >= 4) {
+          m_mediaWidth = payload[0] | (payload[1] << 8);
+          m_mediaHeight = payload[2] | (payload[3] << 8);
+          // Full screen, status bar included: black around the picture.
+          Ion::Display::pushRectUniform(
+              KDRect(0, 0, Ion::Display::Width, Ion::Display::Height), KDColorBlack);
+        }
+        break;
+      case Protocol::MediaRows:
+        if (m_viewing) {
+          handleMediaRows(payload, length);
+        }
+        break;
+      case Protocol::MediaEnd:
+        if (m_viewing) {
+          m_viewing = false;
+          m_viewStillViewable = length >= 1 && payload[0] == 1;
+          if (length > 1) {
+            copyString(m_status, sizeof(m_status),
+                       reinterpret_cast<const char*>(payload + 1), length - 1);
+          }
+        }
+        break;
+      default:
+        break;  // HelloAck, Pong... only count as signs of life
+    }
+  }
+  if (m_sending && Ion::Timing::millis() - m_sendStartTime > k_sendTimeoutMs) {
+    m_sending = false;
+    copyString(m_status, sizeof(m_status), "Pas de reponse du Mac", 21);
+    changed = true;
+  }
+  *linkLost = !linkAlive();
+  return changed;
+}
+
+void ChatController::moveSelection(int delta) {
+  const int next = m_selection + delta;
+  if (next < 0 || next >= m_conversationCount) {
+    return;
+  }
+  m_selection = next;
+  if (m_selection < m_firstVisible) {
+    m_firstVisible = m_selection;
+  } else if (m_selection >= m_firstVisible + ChatView::k_visibleRows) {
+    m_firstVisible = m_selection - ChatView::k_visibleRows + 1;
+  }
+  redrawAll();
+}
+
+bool ChatController::browseList() {
+  m_screen = Screen::List;
+  m_status[0] = '\0';
+  m_conversationCount = 0;
+  m_selection = m_firstVisible = 0;
+  setStatusBarModifiers(Ion::Events::ShiftAlphaStatus());
+  redrawAll();
+  if (!requestList()) {
+    showMessage("Le Mac ne repond pas.\nL'appli NumTube est-elle ouverte ?", true);
+    return false;
+  }
+  KeyWatcher keys;
+  while (true) {
+    const Key key = keys.next();
+    switch (key) {
+      case Key::Up:
+        moveSelection(-1);
+        break;
+      case Key::Down:
+        moveSelection(1);
+        break;
+      case Key::OK:
+      case Key::EXE:
+      case Key::Right:
+        if (m_conversationCount > 0) {
+          if (!runConversation(m_selection)) {
+            return false;
+          }
+          // Back in the list: refresh it, unread markers have changed.
+          m_screen = Screen::List;
+          m_status[0] = '\0';
+          setStatusBarModifiers(Ion::Events::ShiftAlphaStatus());
+          redrawAll();
+          requestList();
+          keys = KeyWatcher();
+        }
+        break;
+      case Key::Back:
+        return true;
+      default:
+        if (isExitKey(key)) {
+          return true;
+        }
+        break;
+    }
+    bool lost;
+    if (pollFrames(false, &lost)) {
+      redrawAll();
+    }
+    if (lost) {
+      return false;
+    }
+  }
+}
+
+void ChatController::scroll(int delta) {
+  const int maxScroll = m_view.totalLines() - ChatView::k_visibleLines;
+  int next = m_scrollLines + delta;
+  if (next > maxScroll) {
+    next = maxScroll;
+  }
+  if (next < 0) {
+    next = 0;
+  }
+  if (next == m_scrollLines) {
+    return;
+  }
+  m_scrollLines = next;
+  if (m_scrollLines == 0) {
+    m_unseenBelow = false;
+  }
+  redraw(ChatView::messagesRect());
+}
+
+bool ChatController::sendInput() {
+  if (m_input.isEmpty() || m_sending) {
+    return true;
+  }
+  if (!m_link.send(Protocol::Send, reinterpret_cast<const uint8_t*>(m_input.text()),
+                   static_cast<uint16_t>(m_input.length()))) {
+    copyString(m_status, sizeof(m_status), "Envoi impossible", 16);
+    return false;
+  }
+  m_sending = true;
+  m_sendStartTime = Ion::Timing::millis();
+  // Follow the conversation down to the message about to appear.
+  m_scrollLines = 0;
+  m_unseenBelow = false;
+  return true;
+}
+
+void ChatController::handleEmojiFrame(const uint8_t* payload, uint16_t length) {
+  constexpr int size = Protocol::k_emojiSize;
+  if (length < 3 + size * size * 2 || payload[0] >= Protocol::k_emojiSlots ||
+      payload[1] != size || payload[2] != size) {
+    return;
+  }
+  const int slot = payload[0];
+  const uint8_t* pixels = payload + 3;
+  for (int i = 0; i < size * size; i++) {
+    m_emojis[slot][i] = KDColor::RGB16(static_cast<uint16_t>(pixels[2 * i] | (pixels[2 * i + 1] << 8)));
+  }
+  m_emojiValid |= static_cast<uint32_t>(1) << slot;
+}
+
+void ChatController::handleMediaRows(const uint8_t* payload, uint16_t length) {
+  if (length < 6 || m_mediaWidth <= 0 || m_mediaWidth > Ion::Display::Width) {
+    return;
+  }
+  const uint16_t frame = static_cast<uint16_t>(payload[0] | (payload[1] << 8));
+  const int y = payload[2] | (payload[3] << 8);
+  const int rows = payload[4];
+  const bool last = payload[5] != 0;
+  const uint8_t* pixels = payload + 6;
+  if (length < 6 + rows * m_mediaWidth * 2) {
+    return;
+  }
+  const int x0 = (Ion::Display::Width - m_mediaWidth) / 2;
+  const int y0 = (Ion::Display::Height - m_mediaHeight) / 2;
+  KDColor line[Ion::Display::Width];
+  for (int r = 0; r < rows && y + r < m_mediaHeight; r++) {
+    const uint8_t* row = pixels + r * m_mediaWidth * 2;
+    for (int x = 0; x < m_mediaWidth; x++) {
+      line[x] = KDColor::RGB16(static_cast<uint16_t>(row[2 * x] | (row[2 * x + 1] << 8)));
+    }
+    Ion::Display::pushRect(KDRect(x0, y0 + y + r, m_mediaWidth, 1), line);
+  }
+  if (last) {
+    const uint8_t ack[2] = {static_cast<uint8_t>(frame), static_cast<uint8_t>(frame >> 8)};
+    m_link.send(Protocol::MediaAck, ack, sizeof(ack));
+  }
+}
+
+/* Shows the snap of message `index` full screen until it ends (its timer on
+ * Snapchat) or Back is pressed. Returns false if the link was lost. */
+bool ChatController::runViewer(int index) {
+  ChatMessage& target = m_messages[(m_messageStart + index) % k_maxMessages];
+  const uint8_t id = target.mediaId;
+  m_viewing = true;
+  m_viewStillViewable = true;
+  m_mediaWidth = m_mediaHeight = 0;
+  m_viewStartTime = Ion::Timing::millis();
+  copyString(m_status, sizeof(m_status), "Ouverture du snap...", 20);
+  redrawAll();
+  m_link.send(Protocol::View, &id, 1);
+  KeyWatcher keys;
+  bool stopSent = false;
+  bool lost = false;
+  while (m_viewing) {
+    const Key key = keys.next();
+    if (!stopSent && (key == Key::Back || key == Key::OK || isExitKey(key))) {
+      m_link.send(Protocol::ViewStop, nullptr, 0);
+      stopSent = true;
+      m_viewStartTime = Ion::Timing::millis();  // give the gateway time to close it
+    }
+    pollFrames(true, &lost);
+    if (lost) {
+      return false;
+    }
+    const uint64_t elapsed = Ion::Timing::millis() - m_viewStartTime;
+    if (m_viewing && ((stopSent && elapsed > 5000) ||
+                      (!stopSent && m_mediaWidth == 0 && elapsed > 15000))) {
+      m_viewing = false;  // never started, or the end was lost
+      copyString(m_status, sizeof(m_status), "Pas de reponse du Mac", 21);
+    }
+  }
+  /* The message may have moved in the ring meanwhile: find it by media id. */
+  if (!m_viewStillViewable) {
+    for (int i = 0; i < m_messageCount; i++) {
+      ChatMessage& m = m_messages[(m_messageStart + i) % k_maxMessages];
+      if ((m.flags & Protocol::k_viewable) && m.mediaId == id) {
+        m.flags &= ~Protocol::k_viewable;
+      }
+    }
+  }
+  // The viewer painted over everything, status bar included.
+  AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+  redrawAll();
+  return true;
+}
+
+bool ChatController::runConversation(int index) {
+  const ConversationEntry& c = m_conversations[index];
+  copyString(m_openId, sizeof(m_openId), c.id, strlen(c.id));
+  copyString(m_openName, sizeof(m_openName), c.name, strlen(c.name));
+  m_screen = Screen::Conversation;
+  m_messageStart = m_messageCount = 0;
+  m_scrollLines = 0;
+  m_unseenBelow = false;
+  m_sending = false;
+  m_historyLoaded = false;
+  m_viewTarget = -1;
+  m_status[0] = '\0';
+  m_input.clear();
+  m_input.resetModifiers();
+  setStatusBarModifiers(m_input.modifiers());
+  redrawAll();
+  m_link.send(Protocol::Open, reinterpret_cast<const uint8_t*>(m_openId),
+              static_cast<uint16_t>(strlen(m_openId)));
+
+  KeyWatcher keys;
+  while (true) {
+    const Key key = keys.next();
+    if (key != Key::None) {
+      if (key == Key::Back || isExitKey(key)) {
+        m_link.send(Protocol::Close, nullptr, 0);
+        return true;
+      }
+      if (key == Key::Up || key == Key::Down) {
+        scroll(key == Key::Up ? 1 : -1);
+      } else if (key == Key::Left || key == Key::Right) {
+        // Page by page.
+        scroll(key == Key::Left ? ChatView::k_visibleLines - 1
+                                : -(ChatView::k_visibleLines - 1));
+      } else if (key == Key::OK && m_input.isEmpty() && !m_sending &&
+                 m_viewTarget >= 0 && m_viewTarget < m_messageCount) {
+        if (!runViewer(m_viewTarget)) {
+          return false;
+        }
+        keys = KeyWatcher();
+      } else if (key == Key::EXE || key == Key::OK) {
+        sendInput();
+        redrawAll();
+      } else if (!m_sending) {
+        switch (m_input.handleKey(key)) {
+          case TextInput::Result::Changed:
+            redraw(ChatView::inputRect());
+            break;
+          case TextInput::Result::Modifier:
+            updateModifierIndicator();
+            break;
+          case TextInput::Result::Ignored:
+            break;
+        }
+      }
+    }
+    bool lost;
+    if (pollFrames(true, &lost)) {
+      redrawAll();
+    }
+    if (lost) {
+      return false;
+    }
+  }
+}
+
+bool ChatController::handleEvent(Ion::Events::Event event) {
+  /* Plugging the cable would normally open the "connected" DFU screen, which
+   * would kill the app. We take over the USB port when a session starts. */
+  if (event == Ion::Events::USBEnumeration) {
+    Ion::USB::clearEnumerationInterrupt();
+    return true;
+  }
+  switch (m_screen) {
+    case Screen::Start:
+      if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+        runSession();
+        return true;
+      }
+      return false;
+    case Screen::Message:
+      if (m_messageNeedsKey && event != Ion::Events::Home && event.isKeyPress()) {
+        showStart();
+        return true;
+      }
+      return false;
+    default:
+      return false;
+  }
+}
+
+}  // namespace Numchat
