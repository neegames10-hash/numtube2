+#pragma once
+
+#include <stdint.h>
+
+/* Frame types carried in TMIA frames between the calculator and the gateway.
+ * Keep in sync with gateway/numscreen_service.py. Hello/HelloAck/Log are
+ * shared with NumTube (see apps/numtube/protocol.h).
+ *
+ * The calculator is a thin client: it shows the picture of the computer
+ * screen and forwards every key press and release. Shift, alpha, the mouse
+ * and the key layout are handled by the gateway. */
+namespace Numscreen {
+namespace Protocol {
+
+enum Type : uint8_t {
+  Start = 0x80,   // PC <- calc: start sharing the screen
+  Frame = 0x81,   // PC -> calc: u16 frame, u16 start tile, u8 flags, tile ops
+  Ack = 0x82,     // PC <- calc: u16 frame, once fully drawn
+  Key = 0x83,     // PC <- calc: u8 key (Ion::Keyboard::Key), u8 down
+  Status = 0x84,  // PC -> calc: UTF-8 text for the bottom strip, 2 lines max
+  Stop = 0x85,    // PC <- calc: Home pressed, release everything
+};
+
+constexpr uint8_t k_endOfFrame = 1;
+constexpr uint16_t k_frameHeader = 5;
+
+}  // namespace Protocol
+}  // namespace Numscreen
diff --git a/epsilon/apps/numscreen/screen_controller.cpp b/epsilon/apps/numscreen/screen_controller.cpp
new file mode 100644
index 0000000000..ffdfe78922
--- /dev/null
+++ b/epsilon/apps/numscreen/screen_controller.cpp
@@ -0,0 +1,322 @@
+#include "screen_controller.h"
+
+#include <apps/apps_container.h>
+#include <ion/display.h>
+#include <ion/keyboard.h>
+#include <ion/timing.h>
+#include <ion/usb.h>
+#include <string.h>
+
+#include "protocol.h"
+
+namespace Numscreen {
+
+using Ion::Keyboard::Key;
+
+namespace {
+
+constexpr KDColor k_background = KDColorWhite;
+constexpr KDColor k_text = KDColor::RGB24(0x202020);
+constexpr KDColor k_muted = KDColor::RGB24(0x707070);
+constexpr KDColor k_accent = KDColor::RGB24(0x2E7DF6);
+constexpr KDColor k_stripBackground = KDColorBlack;
+constexpr KDColor k_stripText = KDColor::RGB24(0xFFB734);
+
+// No frame at all from the gateway for this long: it is gone. The gateway
+// sends a (possibly empty) frame several times per second while sharing.
+constexpr uint32_t k_gatewayTimeoutMs = 15000;
+
+void copyString(char* destination, size_t capacity, const char* source,
+                size_t length) {
+  size_t count = length < capacity - 1 ? length : capacity - 1;
+  // Never cut a UTF-8 sequence in two.
+  if (count < length) {
+    while (count > 0 && (static_cast<uint8_t>(source[count]) & 0xC0) == 0x80) {
+      count--;
+    }
+  }
+  memcpy(destination, source, count);
+  destination[count] = '\0';
+}
+
+int glyphCount(const char* text, int bytes) {
+  int count = 0;
+  for (int i = 0; i < bytes; i++) {
+    const uint8_t byte = static_cast<uint8_t>(text[i]);
+    if ((byte & 0xC0) != 0x80 && byte != 0xCC && byte != 0xCD) {
+      count++;
+    }
+  }
+  return count;
+}
+
+KDContext* screenContext() {
+  KDContext* context = Ion::Display::Context::SharedContext;
+  context->setOrigin(KDPointZero);
+  context->setClippingRect(KDRect(0, 0, Ion::Display::Width, Ion::Display::Height));
+  return context;
+}
+
+bool isExitKey(Key key) { return key == Key::Home || key == Key::OnOff; }
+
+}  // namespace
+
+// --- Start view -------------------------------------------------------------
+
+void StartView::drawCentered(KDContext* ctx, const char* text, int y,
+                             KDColor color, KDFont::Size font) const {
+  const int width = KDFont::GlyphMaxWidth(font);
+  const int height = KDFont::GlyphHeight(font);
+  const KDGlyph::Style style{color, k_background, font};
+  while (*text != '\0') {
+    const char* end = strchr(text, '\n');
+    const int bytes = end ? static_cast<int>(end - text) : static_cast<int>(strlen(text));
+    const int x = (bounds().width() - glyphCount(text, bytes) * width) / 2;
+    ctx->drawString(text, KDPoint(x < 0 ? 0 : x, y), style, bytes);
+    y += height + 2;
+    text += bytes;
+    if (*text == '\n') {
+      text++;
+    }
+  }
+}
+
+void StartView::drawRect(KDContext* ctx, KDRect rect) const {
+  ctx->fillRect(bounds(), k_background);
+  drawCentered(ctx, "NumScreen", 18, k_accent, KDFont::Size::Large);
+  const char* message = m_controller->message();
+  if (message[0] != '\0') {
+    drawCentered(ctx, message, 70, k_text, KDFont::Size::Small);
+    drawCentered(ctx, "OK : relancer", 190, k_accent, KDFont::Size::Small);
+    return;
+  }
+  drawCentered(ctx,
+               "L'ecran de l'ordinateur sur la calculatrice.\n"
+               "Laisse l'appli NumSocial ouverte sur le PC.",
+               52, k_text, KDFont::Size::Small);
+  drawCentered(ctx,
+               "fleches : souris     OK : clic\n"
+               "x,n,t : mode souris / mode jeu\n"
+               "shift : lettres / chiffres   alpha : MAJ\n"
+               "var : ZQSD sur 8 4 5 6\n"
+               "outils : clic droit   maison : arreter",
+               100, k_muted, KDFont::Size::Small);
+  drawCentered(ctx, "OK : lancer le partage", 192, k_accent, KDFont::Size::Small);
+}
+
+// --- Controller -------------------------------------------------------------
+
+ScreenController::ScreenController(Escher::Responder* parentResponder)
+    : Escher::ViewController(parentResponder),
+      m_view(this),
+      m_decoder(m_rowBuffer, this),
+      m_keyState(0),
+      m_lastScan(0),
+      m_autoStart(true),
+      m_stripDirty(false),
+      m_framesSeen(false) {
+  m_message[0] = '\0';
+  m_status[0] = '\0';
+}
+
+void ScreenController::viewWillAppear() { m_view.redrawAll(); }
+
+void ScreenController::showStart() {
+  m_message[0] = '\0';
+  m_view.redrawAll();
+}
+
+void ScreenController::showMessage(const char* message) {
+  copyString(m_message, sizeof(m_message), message, strlen(message));
+  m_view.redrawAll();
+  AppsContainer::sharedAppsContainer()->redrawWindow();
+}
+
+void ScreenController::tick() {
+  // Share as soon as the app is open (once: Home ends a session).
+  if (m_autoStart) {
+    m_autoStart = false;
+    runSession();
+  }
+}
+
+void ScreenController::push(int x, int y, int width, const uint16_t* pixels) {
+  Ion::Display::pushRect(KDRect(x, y, width, 1),
+                         reinterpret_cast<const KDColor*>(pixels));
+}
+
+void ScreenController::drawStrip() {
+  m_stripDirty = false;
+  KDContext* context = screenContext();
+  const KDRect strip(0, k_stripY, Ion::Display::Width, k_stripHeight);
+  context->fillRect(strip, k_stripBackground);
+  const KDFont::Size font = KDFont::Size::Small;
+  const int glyphWidth = KDFont::GlyphMaxWidth(font);
+  const int glyphHeight = KDFont::GlyphHeight(font);
+  int lines = 0;
+  for (const char* c = m_status; *c != '\0'; c++) {
+    lines += (*c == '\n');
+  }
+  lines += (m_status[0] != '\0');
+  int y = k_stripY + (k_stripHeight - lines * (glyphHeight + 2)) / 2;
+  const KDGlyph::Style style{k_stripText, k_stripBackground, font};
+  const char* text = m_status;
+  while (*text != '\0') {
+    const char* end = strchr(text, '\n');
+    const int bytes = end ? static_cast<int>(end - text) : static_cast<int>(strlen(text));
+    const int x = (Ion::Display::Width - glyphCount(text, bytes) * glyphWidth) / 2;
+    context->drawString(text, KDPoint(x < 0 ? 0 : x, y), style, bytes);
+    y += glyphHeight + 2;
+    text += bytes;
+    if (*text == '\n') {
+      text++;
+    }
+  }
+}
+
+void ScreenController::handleFrame(uint8_t type, const uint8_t* payload,
+                                   uint16_t length) {
+  if (type == Protocol::Frame && length >= Protocol::k_frameHeader) {
+    const uint16_t startTile = static_cast<uint16_t>(payload[2] | (payload[3] << 8));
+    m_decoder.decode(startTile, payload + Protocol::k_frameHeader,
+                     length - Protocol::k_frameHeader);
+    if (payload[4] & Protocol::k_endOfFrame) {
+      m_framesSeen = true;
+      m_link.send(Protocol::Ack, payload, 2);
+    }
+  } else if (type == Protocol::Status) {
+    copyString(m_status, sizeof(m_status), reinterpret_cast<const char*>(payload),
+               length);
+    m_stripDirty = true;
+  }
+}
+
+/* Sends every key that went down or up since the last call. Returns false
+ * when Home (or On/Off) asks to stop sharing. The live keyboard state is read
+ * (the event queue only holds presses, not how long a key stays down), and a
+ * change counts once two reads in a row agree, against contact bounce. */
+bool ScreenController::forwardKeys() {
+  while (Ion::Keyboard::popState() != Ion::Keyboard::State(-1)) {
+    // Keep the queue empty so that nothing reaches Escher afterwards.
+  }
+  const uint64_t bits = static_cast<uint64_t>(Ion::Keyboard::scan());
+  if (bits != m_lastScan) {
+    m_lastScan = bits;
+    return true;
+  }
+  uint64_t changed = bits ^ m_keyState;
+  m_keyState = bits;
+  while (changed != 0) {
+    const int index = __builtin_ctzll(changed);
+    changed &= changed - 1;
+    const bool down = (bits >> index) & 1;
+    if (down && isExitKey(static_cast<Key>(index))) {
+      return false;
+    }
+    const uint8_t event[2] = {static_cast<uint8_t>(index),
+                              static_cast<uint8_t>(down ? 1 : 0)};
+    m_link.send(Protocol::Key, event, sizeof(event));
+  }
+  return true;
+}
+
+ScreenController::Exit ScreenController::share() {
+  Ion::Display::pushRectUniform(
+      KDRect(0, 0, Ion::Display::Width, k_pictureHeight), KDColorBlack);
+  copyString(m_status, sizeof(m_status), "Connexion a l'ecran du PC...", 28);
+  drawStrip();
+  m_framesSeen = false;
+  m_keyState = m_lastScan = static_cast<uint64_t>(Ion::Keyboard::scan());
+  m_link.send(Protocol::Start, nullptr, 0);
+
+  uint64_t lastFrame = Ion::Timing::millis();
+  uint64_t lastStart = lastFrame;
+  while (true) {
+    if (!forwardKeys()) {
+      return Exit::Stopped;
+    }
+    if (!Numtube::cablePlugged()) {
+      copyString(m_message, sizeof(m_message), "Cable USB debranche.", 20);
+      return Exit::Error;
+    }
+    uint8_t type;
+    const uint8_t* payload;
+    uint16_t length;
+    // Drain what is ready, but come back regularly for the keyboard.
+    for (int i = 0; i < 32 && m_link.poll(&type, &payload, &length); i++) {
+      lastFrame = Ion::Timing::millis();
+      handleFrame(type, payload, length);
+    }
+    if (m_stripDirty) {
+      drawStrip();
+    }
+    const uint64_t now = Ion::Timing::millis();
+    if (!m_framesSeen && now - lastStart > 4000) {
+      // The request was lost (or the gateway restarted): ask again.
+      m_link.send(Protocol::Start, nullptr, 0);
+      lastStart = now;
+    }
+    if (now - lastFrame > k_gatewayTimeoutMs) {
+      const char* text = "Le PC ne repond plus.\nL'appli NumSocial est-elle ouverte ?";
+      copyString(m_message, sizeof(m_message), text, strlen(text));
+      return Exit::Error;
+    }
+  }
+}
+
+/* While connected, the calculator never hands control back to Epsilon's event
+ * loop: idling there makes the USB port stop answering. So the whole session
+ * runs in share(), and the link closes when it ends. */
+void ScreenController::runSession() {
+  m_message[0] = '\0';
+  if (!m_link.isConnected()) {
+    showMessage("Connexion a l'ordinateur...\nOuvre l'appli NumSocial sur le PC.\n\nRetour : annuler");
+    m_message[0] = '\0';
+    switch (m_link.connect()) {
+      case Numtube::Link::ConnectResult::Connected:
+        break;
+      case Numtube::Link::ConnectResult::Cancelled:
+        showStart();
+        AppsContainer::sharedAppsContainer()->redrawWindow();
+        return;
+      case Numtube::Link::ConnectResult::NoCable:
+        showMessage("Branche la calculatrice a l'ordinateur avec le cable USB.");
+        return;
+    }
+  }
+  m_link.log("numscreen: session");
+  const Exit exit = share();
+  m_link.send(Protocol::Stop, nullptr, 0);
+  // Throw away what was already on the wire.
+  const uint64_t drainEnd = Ion::Timing::millis() + 150;
+  uint8_t type;
+  const uint8_t* payload;
+  uint16_t length;
+  while (Ion::Timing::millis() < drainEnd) {
+    m_link.poll(&type, &payload, &length);
+  }
+  m_link.disconnect();
+  if (exit == Exit::Stopped) {
+    m_message[0] = '\0';
+  }
+  // The session painted over the status bar too.
+  AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+  m_view.redrawAll();
+  AppsContainer::sharedAppsContainer()->redrawWindow();
+}
+
+bool ScreenController::handleEvent(Ion::Events::Event event) {
+  /* Plugging the cable would normally open the "connected" DFU screen, which
+   * would kill the app. We take over the USB port when a session starts. */
+  if (event == Ion::Events::USBEnumeration) {
+    Ion::USB::clearEnumerationInterrupt();
+    return true;
+  }
+  if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+    runSession();
+    return true;
+  }
+  return false;
+}
+
+}  // namespace Numscreen
