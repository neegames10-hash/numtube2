+#include "link.h"
+
+#include <ion/timing.h>
+#include <new>
+#include <ion/usb.h>
+#include <string.h>
+
+#include "protocol.h"
+
+namespace Numtube {
+
+namespace {
+
+constexpr uint16_t crcEntry(uint8_t index) {
+  uint16_t crc = static_cast<uint16_t>(index) << 8;
+  for (int bit = 0; bit < 8; bit++) {
+    crc = (crc & 0x8000) ? static_cast<uint16_t>((crc << 1) ^ 0x1021)
+                         : static_cast<uint16_t>(crc << 1);
+  }
+  return crc;
+}
+
+struct CrcTable {
+  uint16_t values[256];
+  constexpr CrcTable() : values() {
+    for (int i = 0; i < 256; i++) {
+      values[i] = crcEntry(static_cast<uint8_t>(i));
+    }
+  }
+};
+
+constexpr CrcTable k_crcTable;
+
+uint16_t crc16(const uint8_t* data, size_t length) {
+  uint16_t crc = 0xFFFF;
+  for (size_t i = 0; i < length; i++) {
+    crc = static_cast<uint16_t>(
+        (crc << 8) ^ k_crcTable.values[((crc >> 8) ^ data[i]) & 0xFF]);
+  }
+  return crc;
+}
+
+constexpr uint32_t k_writeTimeoutMs = 400;
+constexpr uint32_t k_helloIntervalMs = 700;
+constexpr uint32_t k_cableCheckGraceMs = 1500;
+
+}  // namespace
+
+KeyWatcher::KeyWatcher()
+    : m_pending(0), m_seenUp(~static_cast<uint64_t>(Ion::Keyboard::scan())) {}
+
+Ion::Keyboard::Key KeyWatcher::next() {
+  while (m_pending == 0) {
+    Ion::Keyboard::State state = Ion::Keyboard::popState();
+    if (state == Ion::Keyboard::State(-1)) {
+      return Ion::Keyboard::Key::None;
+    }
+    const uint64_t bits = static_cast<uint64_t>(state);
+    m_pending = bits & m_seenUp;
+    m_seenUp = ~bits;
+  }
+  const int index = __builtin_ctzll(m_pending);
+  m_pending &= m_pending - 1;
+  return static_cast<Ion::Keyboard::Key>(index);
+}
+
+Link::Link() : m_connected(false), m_start(0), m_end(0), m_consumed(0) {}
+
+Link::ConnectResult Link::connect() {
+  if (m_connected) {
+    return ConnectResult::Connected;
+  }
+  if (!cablePlugged()) {
+    return ConnectResult::NoCable;
+  }
+  m_start = m_end = m_consumed = 0;
+  Ion::USB::Termia::streamBegin(m_usbStorage, sizeof(m_usbStorage));
+
+  KeyWatcher keys;
+  const uint64_t startTime = Ion::Timing::millis();
+  uint64_t nextHello = 0;
+  while (true) {
+    Ion::Keyboard::Key key = keys.next();
+    if (key == Ion::Keyboard::Key::Back || key == Ion::Keyboard::Key::Home) {
+      disconnect();
+      return ConnectResult::Cancelled;
+    }
+    if (!cablePlugged() &&
+        Ion::Timing::millis() - startTime > k_cableCheckGraceMs) {
+      disconnect();
+      return ConnectResult::NoCable;
+    }
+    if (!Ion::USB::Termia::streamReady()) {
+      continue;
+    }
+    /* Greet repeatedly: the gateway may start after the calculator. A greeting
+     * nobody reads just times out here without consequence. */
+    const uint64_t now = Ion::Timing::millis();
+    if (now >= nextHello) {
+      nextHello = now + k_helloIntervalMs;
+      m_connected = true;
+      send(Protocol::Hello, nullptr, 0);
+      m_connected = false;
+    }
+    m_connected = true;
+    uint8_t type;
+    const uint8_t* payload;
+    uint16_t length;
+    while (poll(&type, &payload, &length)) {
+      if (type == Protocol::HelloAck) {
+        return ConnectResult::Connected;
+      }
+    }
+    m_connected = false;
+  }
+}
+
+void Link::service() {
+  if (m_connected) {
+    Ion::USB::Termia::streamService(15);
+  }
+}
+
+void Link::disconnect() {
+  Ion::USB::Termia::streamEnd();
+  m_connected = false;
+  m_start = m_end = m_consumed = 0;
+}
+
+bool Link::send(uint8_t type, const uint8_t* payload, uint16_t length) {
+  if (!m_connected ||
+      length + k_headerLength + k_crcLength > k_txCapacity) {
+    return false;
+  }
+  memcpy(m_tx, "TMIA", 4);
+  m_tx[4] = 1;
+  m_tx[5] = type;
+  m_tx[6] = static_cast<uint8_t>(length & 0xFF);
+  m_tx[7] = static_cast<uint8_t>(length >> 8);
+  if (length > 0) {
+    memcpy(m_tx + k_headerLength, payload, length);
+  }
+  const uint16_t crc = crc16(m_tx, k_headerLength + length);
+  m_tx[k_headerLength + length] = static_cast<uint8_t>(crc & 0xFF);
+  m_tx[k_headerLength + length + 1] = static_cast<uint8_t>(crc >> 8);
+  return Ion::USB::Termia::streamWrite(m_tx, k_headerLength + length + k_crcLength,
+                                       k_writeTimeoutMs);
+}
+
+void Link::log(const char* text) {
+  send(Protocol::Log, reinterpret_cast<const uint8_t*>(text),
+       static_cast<uint16_t>(strlen(text)));
+}
+
+bool Link::extractFrame(uint8_t* type, const uint8_t** payload,
+                        uint16_t* length) {
+  while (static_cast<size_t>(m_end - m_start) >= k_headerLength + k_crcLength) {
+    const uint8_t* p = m_rx + m_start;
+    if (memcmp(p, "TMIA", 4) != 0 || p[4] != 1) {
+      m_start++;
+      continue;
+    }
+    const uint16_t bodyLength = static_cast<uint16_t>(p[6] | (p[7] << 8));
+    if (bodyLength > k_maxPayload) {
+      m_start++;
+      continue;
+    }
+    const size_t total = k_headerLength + bodyLength + k_crcLength;
+    if (static_cast<size_t>(m_end - m_start) < total) {
+      return false;
+    }
+    const uint16_t expected = crc16(p, k_headerLength + bodyLength);
+    const uint16_t actual = static_cast<uint16_t>(
+        p[k_headerLength + bodyLength] | (p[k_headerLength + bodyLength + 1] << 8));
+    if (expected != actual) {
+      m_start++;
+      continue;
+    }
+    *type = p[5];
+    *payload = p + k_headerLength;
+    *length = bodyLength;
+    m_consumed = static_cast<uint16_t>(total);
+    return true;
+  }
+  return false;
+}
+
+bool Link::poll(uint8_t* type, const uint8_t** payload, uint16_t* length) {
+  m_start = static_cast<uint16_t>(m_start + m_consumed);
+  m_consumed = 0;
+  if (!m_connected) {
+    return false;
+  }
+  if (extractFrame(type, payload, length)) {
+    return true;
+  }
+  if (k_rxCapacity - m_end < k_usbPacket) {
+    const uint16_t pending = static_cast<uint16_t>(m_end - m_start);
+    memmove(m_rx, m_rx + m_start, pending);
+    m_start = 0;
+    m_end = pending;
+  }
+  if (k_rxCapacity - m_end < k_usbPacket) {
+    m_start = m_end = 0;  // unreachable with valid frames, resynchronise
+  }
+  const uint16_t received = Ion::USB::Termia::streamRead(m_rx + m_end, k_usbPacket);
+  if (received == 0) {
+    return false;
+  }
+  m_end = static_cast<uint16_t>(m_end + received);
+  return extractFrame(type, payload, length);
+}
+
+}  // namespace Numtube
+
+/* NumSocial link for external apps (.nwa), such as the multiplayer NumBlocks.
+ * Published in the userland's vector table (see ion userland boot/isr.cpp),
+ * after the "NSOC" magic word, so that an app can check the firmware has
+ * them before calling. The userland has no RAM to spare: the app lends the
+ * memory of the link (numsocial_link_storage_size() bytes, 8-aligned). */
+namespace {
+Numtube::Link* s_appLink = nullptr;
+}  // namespace
+
+extern "C" {
+
+unsigned int numsocial_link_storage_size() { return sizeof(Numtube::Link); }
+
+/* 1: connected to NumSocial; 0: no cable, Back pressed while waiting, or
+ * storage too small. The storage must stay valid until numsocial_link_close. */
+int numsocial_link_open(void* storage, unsigned int size) {
+  if (s_appLink == nullptr) {
+    if (storage == nullptr || size < sizeof(Numtube::Link) ||
+        (reinterpret_cast<uintptr_t>(storage) & 7) != 0) {
+      return 0;
+    }
+    s_appLink = new (storage) Numtube::Link();
+  }
+  return s_appLink->connect() == Numtube::Link::ConnectResult::Connected ? 1 : 0;
+}
+
+int numsocial_link_send(uint8_t type, const uint8_t* payload, uint16_t length) {
+  return s_appLink != nullptr && s_appLink->isConnected() &&
+                 s_appLink->send(type, payload, length)
+             ? 1
+             : 0;
+}
+
+/* Pumps USB. Returns the length of the frame copied into buffer (cut to
+ * capacity), or -1 when no frame is ready. */
+int numsocial_link_poll(uint8_t* type, uint8_t* buffer, uint16_t capacity) {
+  const uint8_t* payload;
+  uint16_t length;
+  if (s_appLink == nullptr || !s_appLink->isConnected() ||
+      !s_appLink->poll(type, &payload, &length)) {
+    return -1;
+  }
+  const uint16_t count = length < capacity ? length : capacity;
+  memcpy(buffer, payload, count);
+  return count;
+}
+
+// Gives the USB port back; the storage can be reused afterwards.
+void numsocial_link_close() {
+  if (s_appLink != nullptr) {
+    s_appLink->disconnect();
+    s_appLink = nullptr;
+  }
+}
+
+int numsocial_link_plugged() { return Numtube::cablePlugged() ? 1 : 0; }
+
+}  // extern "C"
diff --git a/epsilon/apps/numtube/link.h b/epsilon/apps/numtube/link.h
new file mode 100644
index 0000000000..6258492c9f
--- /dev/null
+++ b/epsilon/apps/numtube/link.h
@@ -0,0 +1,76 @@
+#pragma once
+
+#include <ion/keyboard.h>
+#include <ion/termia_usb.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <ion/usb.h>
+
+namespace Numtube {
+
+// The desktop simulator has no cable; its link is a local TCP socket.
+inline bool cablePlugged() {
+#if defined(PLATFORM_DEVICE)
+  return Ion::USB::isPlugged();
+#else
+  return true;
+#endif
+}
+
+// Tracks which keys went down, from the keyboard interrupt queue. Consuming
+// the queue also keeps stale presses away from Escher once a blocking screen
+// (search, player) returns.
+class KeyWatcher {
+ public:
+  KeyWatcher();
+  // Returns the next newly pressed key, or Key::None when the queue is empty.
+  Ion::Keyboard::Key next();
+
+ private:
+  uint64_t m_pending;
+  uint64_t m_seenUp;
+};
+
+// TMIA framing on top of the USB stream.
+class Link {
+ public:
+  Link();
+
+  enum class ConnectResult { Connected, Cancelled, NoCable };
+  // Blocks until the gateway answers or Back is pressed.
+  ConnectResult connect();
+  void disconnect();
+  // Keeps the USB control endpoint responsive while nothing is read.
+  void service();
+  bool isConnected() const { return m_connected; }
+
+  bool send(uint8_t type, const uint8_t* payload, uint16_t length);
+  // Diagnostic line shown in the gateway terminal.
+  void log(const char* text);
+
+  // Pumps USB without blocking. On true, *payload stays valid until the next
+  // call to poll().
+  bool poll(uint8_t* type, const uint8_t** payload, uint16_t* length);
+
+ private:
+  static constexpr size_t k_headerLength = 8;
+  static constexpr size_t k_crcLength = 2;
+  static constexpr size_t k_maxPayload = 4096;
+  static constexpr size_t k_maxFrame = k_headerLength + k_maxPayload + k_crcLength;
+  static constexpr size_t k_usbPacket = 64;
+  static constexpr size_t k_rxCapacity = k_maxFrame + k_usbPacket;
+  static constexpr size_t k_txCapacity = 256;
+
+  bool extractFrame(uint8_t* type, const uint8_t** payload, uint16_t* length);
+
+  bool m_connected;
+  uint16_t m_start;
+  uint16_t m_end;
+  uint16_t m_consumed;
+  alignas(8) uint8_t m_usbStorage[Ion::USB::Termia::k_streamStorageSize];
+  uint8_t m_rx[k_rxCapacity];
+  uint8_t m_tx[k_txCapacity];
+};
+
+}  // namespace Numtube
diff --git a/epsilon/apps/numtube/main_controller.cpp b/epsilon/apps/numtube/main_controller.cpp
new file mode 100644
index 0000000000..6f81f42459
--- /dev/null
+++ b/epsilon/apps/numtube/main_controller.cpp
@@ -0,0 +1,360 @@
+#include "main_controller.h"
+
+#include <apps/apps_container.h>
+#include <ion/events.h>
+#include <ion/timing.h>
+#include <ion/usb.h>
+#include <string.h>
+
+#include "protocol.h"
+
+namespace Numtube {
+
+namespace {
+
+constexpr uint32_t k_searchTimeoutMs = 60000;
+
+void copyString(char* destination, size_t capacity, const char* source,
+                size_t length) {
+  size_t count = length < capacity - 1 ? length : capacity - 1;
+  memcpy(destination, source, count);
+  destination[count] = '\0';
+}
+
+void setAlphaLock(bool locked) {
+  using Status = Ion::Events::ShiftAlphaStatus;
+  // Through the container so that the status bar indicator follows.
+  AppsContainer::sharedAppsContainer()->setShiftAlphaStatus(
+      Status(Status::ShiftStatus::Inactive,
+             locked ? Status::AlphaStatus::Locked : Status::AlphaStatus::Inactive));
+}
+
+}  // namespace
+
+MainController::MainController(Escher::Responder* parentResponder)
+    : Escher::ViewController(parentResponder),
+      m_view(this),
+      m_player(&m_link),
+      m_screen(Screen::Search),
+      m_resultCount(0),
+      m_selection(0),
+      m_firstVisible(0),
+      m_messageNeedsKey(false) {
+  m_query[0] = '\0';
+  m_message[0] = '\0';
+}
+
+void MainController::viewWillAppear() {
+  showSearch();
+}
+
+void MainController::redrawNow() {
+  m_view.redrawAll();
+  AppsContainer::sharedAppsContainer()->redrawWindow();
+}
+
+void MainController::showSearch() {
+  m_screen = Screen::Search;
+  m_messageNeedsKey = false;
+  setAlphaLock(true);
+  m_view.redrawAll();
+}
+
+void MainController::showResults() {
+  m_screen = Screen::Results;
+  m_messageNeedsKey = false;
+  setAlphaLock(false);
+  m_view.redrawAll();
+}
+
+void MainController::showMessage(const char* message) {
+  copyString(m_message, sizeof(m_message), message, strlen(message));
+  m_screen = Screen::Message;
+  m_view.redrawAll();
+}
+
+void MainController::showMessageNow(const char* message) {
+  showMessage(message);
+  redrawNow();
+}
+
+void MainController::showErrorThenSearch(const char* message) {
+  showMessage(message);
+  m_messageNeedsKey = true;
+}
+
+bool MainController::ensureConnected() {
+  if (m_link.isConnected()) {
+    return true;
+  }
+  showMessageNow("Connexion au PC...\nLance ./numtube");
+  switch (m_link.connect()) {
+    case Link::ConnectResult::Connected:
+      return true;
+    case Link::ConnectResult::Cancelled:
+      showSearch();
+      return false;
+    case Link::ConnectResult::NoCable:
+      showErrorThenSearch("Branche la calculatrice\nau PC avec le cable USB");
+      return false;
+  }
+  return false;
+}
+
+void MainController::parseResult(const uint8_t* payload, uint16_t length) {
+  if (m_resultCount >= k_maxResults || length < 1) {
+    return;
+  }
+  Result& result = m_results[m_resultCount];
+  uint16_t cursor = 0;
+  auto readString = [&](char* destination, size_t capacity) {
+    if (cursor >= length) {
+      destination[0] = '\0';
+      return false;
+    }
+    uint8_t size = payload[cursor++];
+    if (cursor + size > length) {
+      destination[0] = '\0';
+      return false;
+    }
+    copyString(destination, capacity, reinterpret_cast<const char*>(payload + cursor), size);
+    cursor += size;
+    return true;
+  };
+  if (!readString(result.id, sizeof(result.id)) || cursor + 4 > length) {
+    return;
+  }
+  result.durationSeconds = static_cast<uint32_t>(payload[cursor]) |
+                           (static_cast<uint32_t>(payload[cursor + 1]) << 8) |
+                           (static_cast<uint32_t>(payload[cursor + 2]) << 16) |
+                           (static_cast<uint32_t>(payload[cursor + 3]) << 24);
+  cursor += 4;
+  readString(result.title, sizeof(result.title));
+  readString(result.channel, sizeof(result.channel));
+  m_resultCount++;
+}
+
+void MainController::runSearch() {
+  if (!ensureConnected()) {
+    return;
+  }
+  showMessageNow("Recherche...");
+  m_resultCount = 0;
+  m_selection = 0;
+  m_firstVisible = 0;
+  if (!m_link.send(Protocol::Search, reinterpret_cast<const uint8_t*>(m_query),
+                   static_cast<uint16_t>(strlen(m_query)))) {
+    m_link.disconnect();
+    showErrorThenSearch("Le PC ne repond pas.\nLance ./numtube");
+    return;
+  }
+
+  KeyWatcher keys;
+  const uint64_t deadline = Ion::Timing::millis() + k_searchTimeoutMs;
+  while (Ion::Timing::millis() < deadline) {
+    Ion::Keyboard::Key key = keys.next();
+    if (key == Ion::Keyboard::Key::Back || key == Ion::Keyboard::Key::Home) {
+      showSearch();
+      return;
+    }
+    uint8_t type;
+    const uint8_t* payload;
+    uint16_t length;
+    if (!m_link.poll(&type, &payload, &length)) {
+      continue;
+    }
+    if (type == Protocol::Result) {
+      parseResult(payload, length);
+    } else if (type == Protocol::SearchDone) {
+      if (m_resultCount == 0) {
+        showErrorThenSearch("Aucun resultat");
+      } else {
+        showResults();
+      }
+      return;
+    } else if (type == Protocol::Error) {
+      char text[80];
+      copyString(text, sizeof(text), reinterpret_cast<const char*>(payload), length);
+      (void)text;
+      showErrorThenSearch("La recherche a echoue.\nVoir le terminal du PC");
+      return;
+    }
+  }
+  showErrorThenSearch("Le PC ne repond pas.\nLance ./numtube");
+}
+
+void MainController::runPlayer() {
+  if (!ensureConnected()) {
+    return;
+  }
+  m_link.log("controller: play");
+  Player::Exit exit = m_player.play(m_results[m_selection].id);
+  switch (exit) {
+    case Player::Exit::Finished:
+    case Player::Exit::Stopped:
+      showResults();
+      break;
+    case Player::Exit::Error:
+      showErrorThenSearch(m_player.errorMessage()[0] != '\0'
+                              ? m_player.errorMessage()
+                              : "La lecture a echoue");
+      break;
+    case Player::Exit::Disconnected:
+      m_link.disconnect();
+      showErrorThenSearch("Cable USB debranche");
+      break;
+  }
+  // The player painted over the status bar too.
+  AppsContainer::sharedAppsContainer()->reloadTitleBarView();
+  m_view.redrawAll();
+  AppsContainer::sharedAppsContainer()->redrawWindow();
+}
+
+/* While connected, the calculator never hands control back to Epsilon's
+ * event loop: when it idles there the USB port stops answering and the host
+ * drops the link. So a session (search, results, playback) runs in its own
+ * loops, and the link is closed when the user goes back to typing. */
+void MainController::runSession() {
+  runSearch();
+  if (m_screen == Screen::Results) {
+    browseResults();
+  }
+  m_link.disconnect();
+  if (m_screen == Screen::Results) {
+    showSearch();
+  }
+}
+
+void MainController::moveSelection(int delta) {
+  const int next = m_selection + delta;
+  if (next < 0 || next >= m_resultCount) {
+    return;
+  }
+  m_selection = next;
+  if (m_selection < m_firstVisible) {
+    m_firstVisible = m_selection;
+  } else if (m_selection >= m_firstVisible + k_visibleRows) {
+    m_firstVisible = m_selection - k_visibleRows + 1;
+  }
+  redrawNow();
+}
+
+void MainController::browseResults() {
+  redrawNow();
+  KeyWatcher keys;
+  while (true) {
+    const Ion::Keyboard::Key key = keys.next();
+    switch (key) {
+      case Ion::Keyboard::Key::Up:
+        moveSelection(-1);
+        break;
+      case Ion::Keyboard::Key::Down:
+        moveSelection(1);
+        break;
+      case Ion::Keyboard::Key::OK:
+      case Ion::Keyboard::Key::EXE:
+        runPlayer();
+        if (m_screen != Screen::Results) {
+          return;  // an error message is shown
+        }
+        keys = KeyWatcher();
+        break;
+      case Ion::Keyboard::Key::Back:
+      case Ion::Keyboard::Key::Home:
+      case Ion::Keyboard::Key::OnOff:
+        return;
+      default:
+        break;
+    }
+    if (!cablePlugged()) {
+      showErrorThenSearch("Cable USB debranche");
+      return;
+    }
+    // Keep the USB port answering, and drop anything left over on the wire.
+    uint8_t type;
+    const uint8_t* payload;
+    uint16_t length;
+    m_link.poll(&type, &payload, &length);
+  }
+}
+
+bool MainController::handleSearchEvent(Ion::Events::Event event) {
+  size_t length = strlen(m_query);
+  if (event == Ion::Events::EXE || event == Ion::Events::OK) {
+    if (length > 0) {
+      runSession();
+    }
+    return true;
+  }
+  if (event == Ion::Events::Backspace) {
+    if (length > 0) {
+      m_query[length - 1] = '\0';
+      m_view.redrawAll();
+    }
+    return true;
+  }
+  if (event == Ion::Events::Clear) {
+    m_query[0] = '\0';
+    m_view.redrawAll();
+    return true;
+  }
+  char buffer[4] = {0};
+  size_t size = Ion::Events::copyText(static_cast<uint8_t>(event), buffer, sizeof(buffer));
+  if (size == 1 && length + 1 < k_queryCapacity) {
+    m_query[length] = buffer[0];
+    m_query[length + 1] = '\0';
+    m_view.redrawAll();
+    return true;
+  }
+  return false;
+}
+
+bool MainController::handleResultsEvent(Ion::Events::Event event) {
+  if (event == Ion::Events::Up || event == Ion::Events::Down) {
+    const int delta = event == Ion::Events::Up ? -1 : 1;
+    const int next = m_selection + delta;
+    if (next >= 0 && next < m_resultCount) {
+      m_selection = next;
+      if (m_selection < m_firstVisible) {
+        m_firstVisible = m_selection;
+      } else if (m_selection >= m_firstVisible + k_visibleRows) {
+        m_firstVisible = m_selection - k_visibleRows + 1;
+      }
+      m_view.redrawAll();
+    }
+    return true;
+  }
+  if (event == Ion::Events::OK || event == Ion::Events::EXE) {
+    runPlayer();
+    return true;
+  }
+  if (event == Ion::Events::Back) {
+    showSearch();
+    return true;
+  }
+  return false;
+}
+
+bool MainController::handleEvent(Ion::Events::Event event) {
+  /* Plugging the cable would normally open the "connected" DFU screen, which
+   * would kill the app. We take over the USB port when a search starts. */
+  if (event == Ion::Events::USBEnumeration) {
+    Ion::USB::clearEnumerationInterrupt();
+    return true;
+  }
+  switch (m_screen) {
+    case Screen::Search:
+      return handleSearchEvent(event);
+    case Screen::Results:
+      return handleResultsEvent(event);
+    case Screen::Message:
+      if (m_messageNeedsKey && event != Ion::Events::Home && event.isKeyPress()) {
+        showSearch();
+        return true;
+      }
+      return false;
+  }
+  return false;
+}
+
+}  // namespace Numtube
