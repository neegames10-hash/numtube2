diff --git a/epsilon/apps/numchat/protocol.h b/epsilon/apps/numchat/protocol.h
new file mode 100644
index 0000000000..344b01cac0
--- /dev/null
+++ b/epsilon/apps/numchat/protocol.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <stdint.h>
+
+/* Frame types carried in TMIA frames between the calculator and the gateway.
+ * Keep in sync with gateway/numchat_service.py. Hello/HelloAck/Log are shared
+ * with NumTube (see apps/numtube/protocol.h).
+ *
+ * Strings marked str8 are a length byte followed by UTF-8 bytes. Accents travel
+ * decomposed (NFD): a base letter then a combining accent (0xCC/0xCD lead). */
+namespace Numchat {
+namespace Protocol {
+
+enum Type : uint8_t {
+  Hello = 0x0A,
+  HelloAck = 0x0B,
+  Log = 0x4B,
+  List = 0x60,          // PC <- calc: send me the conversation list
+  Conversation = 0x61,  // PC -> calc: u8 index, u8 flags, str8 id, str8 name,
+                        //             str8 preview. Index 0 starts a new list.
+  ListDone = 0x62,      // PC -> calc: u8 count
+  Open = 0x63,          // PC <- calc: conversation id
+  Message = 0x64,       // PC -> calc: u8 flags, str8 sender, text (rest)
+  OpenDone = 0x65,      // PC -> calc: history sent, live messages follow
+  Send = 0x66,          // PC <- calc: UTF-8 text typed on the calculator
+  SendResult = 0x67,    // PC -> calc: u8 ok, error text (rest)
+  Close = 0x68,         // PC <- calc: left the conversation
+  Status = 0x69,        // PC -> calc: UTF-8 notice, empty to clear
+  Ping = 0x6A,          // PC <- calc: are you there? (answered by Pong)
+  Pong = 0x6B,          // PC -> calc
+  Emoji = 0x6C,         // PC -> calc: u8 slot, u8 w, u8 h, RGB565 pixels
+  View = 0x6D,          // PC <- calc: u8 media id (show this snap)
+  MediaStart = 0x6E,    // PC -> calc: u16 w, u16 h
+  MediaRows = 0x6F,     // PC -> calc: u16 frame, u16 y, u8 rows, u8 last,
+                        //             RGB565 pixels
+  MediaEnd = 0x70,      // PC -> calc: u8 still viewable, reason text
+  MediaAck = 0x71,      // PC <- calc: u16 frame, once fully drawn
+  ViewStop = 0x72,      // PC <- calc: Back pressed in the viewer
+};
+
+// Conversation flags
+constexpr uint8_t k_unread = 1;
+
+// Message flags
+constexpr uint8_t k_mine = 1;     // sent by the calculator's owner
+constexpr uint8_t k_info = 2;     // notice from Snapchat (screenshot, ...)
+constexpr uint8_t k_media = 4;    // text is a label such as "photo"
+constexpr uint8_t k_history = 8;  // part of the history sent on Open
+// A snap/photo that can be shown: a u8 media id follows the sender.
+constexpr uint8_t k_viewable = 16;
+
+/* Emojis travel as private-use characters U+E000 + slot (UTF-8 EE 80 80+slot)
+ * whose 14x14 picture came earlier in an Emoji frame. */
+constexpr int k_emojiSlots = 32;
+constexpr int k_emojiSize = 14;
+
+}  // namespace Protocol
+}  // namespace Numchat
diff --git a/epsilon/apps/numchat/text_input.cpp b/epsilon/apps/numchat/text_input.cpp
new file mode 100644
index 0000000000..267949f352
--- /dev/null
+++ b/epsilon/apps/numchat/text_input.cpp
@@ -0,0 +1,203 @@
+#include "text_input.h"
+
+#include <string.h>
+
+namespace Numchat {
+
+namespace {
+
+using Ion::Keyboard::Key;
+using Status = Ion::Events::ShiftAlphaStatus;
+
+bool isCombiningLead(uint8_t byte) { return byte == 0xCC || byte == 0xCD; }
+
+// Second byte of the UTF-8 encoding of the combining accents (all 0xCC xx).
+constexpr uint8_t k_grave = 0x80;       // U+0300
+constexpr uint8_t k_acute = 0x81;       // U+0301
+constexpr uint8_t k_circumflex = 0x82;  // U+0302
+constexpr uint8_t k_tilde = 0x83;       // U+0303
+constexpr uint8_t k_diaeresis = 0x88;   // U+0308
+constexpr uint8_t k_cedilla = 0xA7;     // U+0327
+
+// Accents each letter can take, in the order Ans cycles through them.
+const uint8_t* accentsFor(char letter) {
+  static constexpr uint8_t a[] = {k_grave, k_circumflex, k_diaeresis, 0};
+  static constexpr uint8_t e[] = {k_acute, k_grave, k_circumflex, k_diaeresis, 0};
+  static constexpr uint8_t i[] = {k_circumflex, k_diaeresis, 0};
+  static constexpr uint8_t o[] = {k_circumflex, k_diaeresis, 0};
+  static constexpr uint8_t u[] = {k_grave, k_circumflex, k_diaeresis, 0};
+  static constexpr uint8_t c[] = {k_cedilla, 0};
+  static constexpr uint8_t n[] = {k_tilde, 0};
+  static constexpr uint8_t y[] = {k_diaeresis, 0};
+  switch (letter | 0x20) {  // lower case
+    case 'a': return a;
+    case 'e': return e;
+    case 'i': return i;
+    case 'o': return o;
+    case 'u': return u;
+    case 'c': return c;
+    case 'n': return n;
+    case 'y': return y;
+    default: return nullptr;
+  }
+}
+
+}  // namespace
+
+TextInput::TextInput() : m_length(0) {
+  m_text[0] = '\0';
+  resetModifiers();
+}
+
+void TextInput::clear() {
+  m_length = 0;
+  m_text[0] = '\0';
+}
+
+void TextInput::resetModifiers() {
+  m_modifiers = Status(Status::ShiftStatus::Inactive, Status::AlphaStatus::Locked);
+}
+
+int TextInput::glyphCount(const char* text, size_t length) {
+  int glyphs = 0;
+  for (size_t i = 0; i < length; i++) {
+    const uint8_t byte = static_cast<uint8_t>(text[i]);
+    if ((byte & 0xC0) == 0x80) {
+      continue;  // continuation byte
+    }
+    if (isCombiningLead(byte)) {
+      continue;
+    }
+    glyphs++;
+  }
+  return glyphs;
+}
+
+bool TextInput::insert(const char* bytes, size_t length) {
+  if (m_length + length > k_capacity) {
+    return false;
+  }
+  memcpy(m_text + m_length, bytes, length);
+  m_length += length;
+  m_text[m_length] = '\0';
+  return true;
+}
+
+void TextInput::eraseLastGlyph() {
+  // Drop trailing combining accents together with their base letter.
+  while (m_length > 0) {
+    size_t start = m_length - 1;
+    while (start > 0 && (static_cast<uint8_t>(m_text[start]) & 0xC0) == 0x80) {
+      start--;
+    }
+    const bool combining = isCombiningLead(static_cast<uint8_t>(m_text[start]));
+    m_length = start;
+    if (!combining) {
+      break;
+    }
+  }
+  m_text[m_length] = '\0';
+}
+
+bool TextInput::cycleAccent() {
+  // The text ends with a letter, optionally followed by one accent (2 bytes).
+  size_t base = m_length;
+  uint8_t current = 0;
+  if (m_length >= 3 && static_cast<uint8_t>(m_text[m_length - 2]) == 0xCC) {
+    current = static_cast<uint8_t>(m_text[m_length - 1]);
+    base = m_length - 2;
+  }
+  if (base == 0) {
+    return false;
+  }
+  const uint8_t* accents = accentsFor(m_text[base - 1]);
+  if (accents == nullptr) {
+    return false;
+  }
+  uint8_t next = accents[0];
+  if (current != 0) {
+    int index = 0;
+    while (accents[index] != 0 && accents[index] != current) {
+      index++;
+    }
+    next = accents[index] == 0 ? accents[0] : accents[index + 1];
+  }
+  m_length = base;
+  m_text[m_length] = '\0';
+  if (next != 0) {
+    const char accent[2] = {static_cast<char>(0xCC), static_cast<char>(next)};
+    insert(accent, 2);
+  }
+  return true;
+}
+
+TextInput::Result TextInput::handleKey(Key key) {
+  if (key == Key::Shift) {
+    m_modifiers.toggleShift();
+    return Result::Modifier;
+  }
+  if (key == Key::Alpha) {
+    m_modifiers.cycleAlpha();
+    return Result::Modifier;
+  }
+  if (key == Key::Backspace) {
+    /* Shift+Backspace clears everything, but not with caps lock (shift under
+     * locked alpha), where it would wipe the text by surprise. */
+    if (m_modifiers.shiftIsActive() && !m_modifiers.alphaIsActive()) {
+      clear();
+      m_modifiers.removeShift();
+    } else {
+      eraseLastGlyph();
+    }
+    return Result::Changed;
+  }
+  if (key == Key::Ans) {
+    return cycleAccent() ? Result::Changed : Result::Ignored;
+  }
+  if (key == Key::EE) {
+    insert("'", 1);
+    return Result::Changed;
+  }
+
+  /* Same mapping as Ion::Events::Event(key, shift, alpha, lock), which only
+   * exists in the kernel: try the most specific layer, fall back to the
+   * plainer ones (shift-alpha -> alpha -> plain, shift -> plain). */
+  using Event = Ion::Events::Event;
+  const bool shift = m_modifiers.shiftIsActive();
+  const bool alpha = m_modifiers.alphaIsActive();
+  int offsets[3];
+  int count = 0;
+  if (shift && alpha) {
+    offsets[count++] = Event::k_shiftAlphaEventsOffset;
+  }
+  if (alpha) {
+    offsets[count++] = Event::k_alphaEventsOffset;
+  } else if (shift) {
+    offsets[count++] = Event::k_shiftEventsOffset;
+  }
+  offsets[count++] = Event::k_plainEventsOffset;
+  uint8_t eventId = static_cast<uint8_t>(key);
+  for (int i = 0; i < count; i++) {
+    eventId = static_cast<uint8_t>(offsets[i] + static_cast<int>(key));
+    if (Ion::Events::isDefined(eventId)) {
+      break;
+    }
+  }
+  char text[8];
+  const size_t size = Ion::Events::copyText(eventId, text, sizeof(text));
+  /* Only single characters: plain keys also produce math snippets such as
+   * "e^(" or "log(" that make no sense in a chat. */
+  if (size == 0 || TextInput::glyphCount(text, strlen(text)) != 1 ||
+      static_cast<uint8_t>(text[0]) < 0x20) {
+    return Result::Ignored;
+  }
+  const bool inserted = insert(text, strlen(text));
+  // One-shot modifiers end with the character they applied to.
+  if (!m_modifiers.alphaIsLocked()) {
+    m_modifiers.removeShift();
+    m_modifiers.removeAlpha();
+  }
+  return inserted ? Result::Changed : Result::Ignored;
+}
+
+}  // namespace Numchat
diff --git a/epsilon/apps/numchat/text_input.h b/epsilon/apps/numchat/text_input.h
new file mode 100644
index 0000000000..0a7e268066
--- /dev/null
+++ b/epsilon/apps/numchat/text_input.h
@@ -0,0 +1,49 @@
+#pragma once
+
+#include <ion/events.h>
+#include <ion/keyboard.h>
+#include <stddef.h>
+#include <stdint.h>
+
+namespace Numchat {
+
+/* Text entry driven by raw key presses (Ion::Keyboard), for screens that never
+ * return to Escher's event loop. Shift and Alpha follow Epsilon's rules (see
+ * Ion::Events::ModifierState), alpha starts locked since a chat is mostly
+ * letters. Accents are typed by pressing Ans after a letter, which cycles
+ * through the accents that letter can take. The text is kept decomposed
+ * (NFD), the way the calculator fonts draw accents. */
+class TextInput {
+ public:
+  static constexpr size_t k_capacity = 200;  // bytes, without the final 0
+
+  TextInput();
+
+  enum class Result {
+    Ignored,   // not a text key: the caller handles it (arrows, EXE, Back...)
+    Changed,   // the text changed
+    Modifier,  // shift/alpha changed (the indicator needs a redraw)
+  };
+  Result handleKey(Ion::Keyboard::Key key);
+
+  const char* text() const { return m_text; }
+  size_t length() const { return m_length; }
+  bool isEmpty() const { return m_length == 0; }
+  void clear();
+  Ion::Events::ShiftAlphaStatus modifiers() const { return m_modifiers; }
+  void resetModifiers();
+
+  // Number of glyphs (combining accents take no room).
+  static int glyphCount(const char* text, size_t length);
+
+ private:
+  bool insert(const char* bytes, size_t length);
+  void eraseLastGlyph();
+  bool cycleAccent();
+
+  Ion::Events::ShiftAlphaStatus m_modifiers;
+  size_t m_length;
+  char m_text[k_capacity + 1];
+};
+
+}  // namespace Numchat
