+#if NUMTUBE_TCP_STREAM
+/* Desktop simulator: the "cable" is a TCP connection to the gateway started
+ * with `./numtube --tcp` (port 9735), so the app can be tested without a
+ * calculator. */
+namespace {
+int s_socket = -1;
+bool s_connected = false;
+}  // namespace
+
+bool streamBegin(void* /*storage*/, size_t /*storageSize*/) {
+  streamEnd();
+  s_socket = socket(AF_INET, SOCK_STREAM, 0);
+  if (s_socket < 0) {
+    return false;
+  }
+  fcntl(s_socket, F_SETFL, fcntl(s_socket, F_GETFL) | O_NONBLOCK);
+  sockaddr_in address = {};
+  address.sin_family = AF_INET;
+  address.sin_port = htons(9735);
+  address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  connect(s_socket, reinterpret_cast<sockaddr*>(&address), sizeof(address));
+  return true;
+}
+
+bool streamReady() {
+  if (s_socket < 0) {
+    return false;
+  }
+  if (!s_connected) {
+    pollfd p = {s_socket, POLLOUT, 0};
+    int error = 0;
+    socklen_t length = sizeof(error);
+    if (poll(&p, 1, 0) == 1 &&
+        getsockopt(s_socket, SOL_SOCKET, SO_ERROR, &error, &length) == 0) {
+      if (error != 0) {
+        streamBegin(nullptr, 0);  // nobody listening yet, retry
+        usleep(200000);
+        return false;
+      }
+      s_connected = true;
+    }
+  }
+  return s_connected;
+}
+
+void streamService(uint32_t /*durationMs*/) {}
+
+void streamEnd() {
+  if (s_socket >= 0) {
+    close(s_socket);
+  }
+  s_socket = -1;
+  s_connected = false;
+}
+
+uint16_t streamRead(uint8_t* buffer, uint16_t cap) {
+  if (!s_connected) {
+    return 0;
+  }
+  ssize_t n = recv(s_socket, buffer, cap < 64 ? cap : 64, 0);
+  return n > 0 ? static_cast<uint16_t>(n) : 0;
+}
+
+bool streamWrite(const uint8_t* data, size_t length, uint32_t /*timeoutMs*/) {
+  size_t sent = 0;
+  while (s_connected && sent < length) {
+    ssize_t n = send(s_socket, data + sent, length - sent, 0);
+    if (n > 0) {
+      sent += static_cast<size_t>(n);
+    } else if (errno != EAGAIN) {
+      return false;
+    }
+  }
+  return sent == length;
+}
