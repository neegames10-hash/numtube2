+++ b/epsilon/apps/numchat/chat_view.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <escher/view.h>
+#include <kandinsky/font.h>
+
+namespace Numchat {
+
+class ChatController;
+
+class ChatView : public Escher::View {
+ public:
+  explicit ChatView(const ChatController* controller) : m_controller(controller) {}
+  void drawRect(KDContext* ctx, KDRect rect) const override;
+  void redrawAll() { markRectAsDirty(bounds()); }
+  void redrawRect(KDRect rect) { markRectAsDirty(rect); }
+
+  // Layout, shared with the controller (which redraws only what changed).
+  static constexpr int k_width = 320;
+  static constexpr int k_height = 222;  // below Epsilon's title bar
+  static constexpr int k_headerHeight = 22;
+  static constexpr int k_glyphWidth = KDFont::GlyphMaxWidth(KDFont::Size::Small);
+  static constexpr int k_glyphHeight = KDFont::GlyphHeight(KDFont::Size::Small);
+  static constexpr int k_lineHeight = k_glyphHeight + 1;
+  static constexpr int k_inputHeight = 2 * k_lineHeight + 14;
+  static constexpr int k_messagesTop = k_headerHeight + 3;
+  static constexpr int k_visibleLines =
+      (k_height - k_headerHeight - k_inputHeight - 3) / k_lineHeight;
+  static constexpr int k_bubbleColumns = 32;
+  static constexpr int k_infoColumns = 42;
+  static constexpr int k_inputColumns = 40;
+  static constexpr int k_rowHeight = 40;
+  static constexpr int k_visibleRows = (k_height - k_headerHeight) / k_rowHeight;
+
+  static KDRect headerRect() { return KDRect(0, 0, k_width, k_headerHeight); }
+  static KDRect messagesRect() {
+    return KDRect(0, k_headerHeight, k_width,
+                  k_height - k_headerHeight - k_inputHeight);
+  }
+  static KDRect inputRect() {
+    return KDRect(0, k_height - k_inputHeight, k_width, k_inputHeight);
+  }
+
+  /* Byte length of the next line of `text` holding at most `columns` glyphs,
+   * cut after a word when possible. *next receives where the following line
+   * starts (spaces at the cut are skipped). */
+  static int lineLength(const char* text, int columns, const char** next);
+  // Lines taken by message i of the open conversation.
+  int linesForMessage(int index) const;
+  int totalLines() const;
+
+ private:
+  void drawCentered(KDContext* ctx, const char* text, int y, KDColor color,
+                    KDFont::Size font) const;
+  void drawStartOrMessage(KDContext* ctx) const;
+  void drawList(KDContext* ctx) const;
+  void drawConversation(KDContext* ctx) const;
+  void drawInput(KDContext* ctx) const;
+  bool showsSenderName(int index) const;
+
+  const ChatController* m_controller;
+};
+
+}  // namespace Numchat
