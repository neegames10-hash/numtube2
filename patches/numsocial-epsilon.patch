+#pragma once
+
+#include <apps/i18n.h>
+
+namespace Home {
+
+/* Which homebrew apps (NumTube, NumChat, NumScreen) show on the Home screen. Both are
+ * always compiled in; the installer on the computer hides the ones the user
+ * did not pick by writing a bit mask into this firmware image (it finds the
+ * mask by its magic string, like it finds the version in the header). */
+bool homebrewAppIsHidden(I18n::Message appName);
+
+}  // namespace Home
