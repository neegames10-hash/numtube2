+#pragma once
+
+#include <config/usb.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <array>
+
+#include "cdc_interface.h"
+#include "stack/descriptor/cdc_functional_descriptor.h"
+#include "stack/descriptor/configuration_descriptor.h"
+#include "stack/descriptor/descriptor.h"
+#include "stack/descriptor/device_descriptor.h"
+#include "stack/descriptor/endpoint_descriptor.h"
+#include "stack/descriptor/extended_compat_id_descriptor.h"
+#include "stack/descriptor/microsoft_os_string_descriptor.h"
+#include "stack/descriptor/interface_association_descriptor.h"
+#include "stack/descriptor/interface_descriptor.h"
+#include "stack/descriptor/language_id_string_descriptor.h"
+#include "stack/descriptor/string_descriptor.h"
+#include "stack/device.h"
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+/* TermiaBridge — the USB device TermiaFirmware brings up when the
+ * calculator is running in tethered mode.
+ *
+ * Advertises a single USB configuration with two interfaces:
+ *   Interface 0: CDC Communications Class (0x02 / 0x02 / 0x00) + one
+ *                interrupt-IN endpoint for notifications.
+ *   Interface 1: CDC Data Class (0x0A / 0x00 / 0x00) + a pair of bulk
+ *                endpoints (OUT + IN) for TMIA packet traffic.
+ *
+ * Both interfaces are grouped by an Interface Association Descriptor
+ * so IAD-aware hosts present them as one virtual serial port under a
+ * single `/dev/ttyACM*` node.
+ *
+ * This class is intentionally separate from `Calculator` (the DFU-only
+ * device). They share the same USB peripheral but are never active
+ * concurrently — bringing one up takes over the controller, disabling
+ * the other. This keeps the DFU flash/recovery path completely
+ * unaffected by Phase-6 work.
+ *
+ * This header is only compiled into userland builds; bootloader/
+ * flasher/eraser pull in `Calculator` instead. */
+class TermiaBridge : public Device {
+ public:
+  // Endpoint layout (bEndpointAddress). Bit 7 = IN direction.
+  static constexpr uint8_t k_cdcNotificationEndpoint = 0x81;  // EP1 IN
+  static constexpr uint8_t k_cdcBulkOutEndpoint = 0x02;       // EP2 OUT
+  static constexpr uint8_t k_cdcBulkInEndpoint = 0x82;        // EP2 IN
+  // bulk/interrupt packet sizes for full-speed USB.
+  static constexpr uint16_t k_cdcNotificationMaxPacketSize = 16;
+  static constexpr uint16_t k_cdcBulkMaxPacketSize = 64;
+
+  explicit TermiaBridge(const char* serialNumber);
+
+  void leave(uint32_t /*leaveAddress*/) override {
+    /* Nothing to do on leave from tethered mode — we just stop polling
+     * and the userland returns to Termia's event loop. */
+  }
+
+  /* Reattach after a prior tether session left USB enabled. Assumes
+   * enumeration has already completed and the hardware's bulk endpoint
+   * registers may or may not retain valid configuration. Idempotently
+   * re-programs them and marks the bridge ready so sendFrame etc.
+   * succeed without waiting for a new SET_CONFIGURATION from the host. */
+  void reattachAfterTether() {
+    initBulkEndpoints();
+    m_bulkEndpointsReady = true;
+  }
+
+  /* Bulk OUT handler mode.
+   *   - Raw: every packet is echoed verbatim on bulk IN (Session 4
+   *     correctness check).
+   *   - TmiaServer: interprets packets as TMIA frames. PING frames
+   *     are answered with PONG frames carrying the same payload;
+   *     other types are dropped (Session 5).
+   *   - TmiaClient: received bulk-OUT packets are stashed verbatim
+   *     in the RX slot for the caller to inspect via
+   *     tryPopReceivedFrame. The OUT endpoint is not re-armed until
+   *     the caller consumes. Used for calc-initiated flows like the
+   *     `claude` command where the calc sends a request and waits
+   *     for chunks streamed back by the bridge (Session 7).
+   *   - Disabled: receive only, no response. */
+  enum class Mode { Disabled, Raw, TmiaServer, TmiaClient };
+  void setMode(Mode m) { m_mode = m; }
+
+  /* True once the host has sent SET_CONFIGURATION and the bulk
+   * endpoints are initialized. Calls to sendFrame before this are
+   * no-ops. Callers in TmiaClient mode should spin-poll until this
+   * returns true before attempting to send. */
+  bool isBulkReady() const { return m_bulkEndpointsReady; }
+
+  /* Push a single TMIA frame of up to 64 bytes onto bulk IN.
+   * Spin-polls briefly until any prior TX is drained. Returns false
+   * if the bridge isn't ready yet or the frame is over-size. */
+  bool sendFrame(const uint8_t* bytes, uint16_t len);
+
+  /* Streaming helpers (NumTube). Unlike sendFrame these never spin, so
+   * the caller can give up when the host stops reading. */
+  bool isTxBusy() const { return m_bulkInBusy; }
+  bool writePacket(const uint8_t* bytes, uint16_t len) {
+    return bulkTransmit(bytes, len);
+  }
+
+  /* Non-destructively inspect whether a packet is waiting in the RX
+   * slot. For TmiaClient mode only; other modes never populate the
+   * slot. */
+  bool hasReceivedFrame() const { return m_rxPendingLen > 0; }
+
+  /* Copy the pending packet out to `buf` (up to `bufCap` bytes),
+   * clear the slot, and re-arm OUT for the next packet. Returns
+   * false if no packet is waiting. */
+  bool tryPopReceivedFrame(uint8_t* buf, uint16_t bufCap, uint16_t* outLen);
+
+ protected:
+  Descriptor* descriptor(uint8_t type, uint8_t index) override;
+  bool processSetupInRequest(SetupPacket* request, uint8_t* transferBuffer,
+                             uint16_t* transferBufferLength,
+                             uint16_t transferBufferMaxLength) override;
+  void setActiveConfiguration(uint8_t configurationIndex) override;
+  uint8_t getActiveConfiguration() override { return k_bConfigurationValue; }
+  void handleBulkOutPacket(uint8_t epNum, uint16_t byteCount) override;
+  void handleBulkInComplete(uint8_t epNum) override;
+  void clearEndpointHalt(uint8_t endpointAddress) override;
+
+ private:
+  static constexpr uint8_t k_bConfigurationValue = 1;
+  static constexpr uint8_t k_cdcControlInterfaceNumber = 0;
+  static constexpr uint8_t k_cdcDataInterfaceNumber = 1;
+
+  // Descriptor-list layout (indices used by descriptor(type,index)).
+  static constexpr size_t k_numberOfDescriptors = 6;
+  using DescriptorList = std::array<Descriptor*, k_numberOfDescriptors>;
+  static constexpr DescriptorList makeDescriptorList(auto&&... descriptors) {
+    static_assert(sizeof...(descriptors) == k_numberOfDescriptors);
+    return DescriptorList{descriptors...};
+  }
+
+  // Bulk endpoint numbers (lower 4 bits of bEndpointAddress).
+  static constexpr uint8_t k_bulkOutEpNum = 0x02;
+  static constexpr uint8_t k_bulkInEpNum = 0x02;
+  // Notification endpoint number — descriptors advertise it but the
+  // Linux cdc_acm driver does not require us to actually arm it.
+  static constexpr uint8_t k_notifEpNum = 0x01;
+
+  void initBulkEndpoints();
+  void armBulkOutReceive();
+  // Queue `len` bytes for transmission on bulk IN. Returns true if the
+  // transfer was armed. Blocks until previous TX completes if one is
+  // in flight (brief — handle both polled from the same caller).
+  bool bulkTransmit(const uint8_t* data, uint16_t len);
+
+  // --- USB interface (single instance, handles both CDC interfaces'
+  // control-endpoint traffic; CDC Data has no class-specific requests).
+  CDCInterface m_cdcInterface;
+
+  // Bulk OUT handler mode (see setMode) plus a scratch buffer for
+  // the packet being processed. One packet per handler invocation;
+  // frames larger than k_bulkPacketSize are not supported here
+  // (future multi-packet assembly lives in a Session 6 ring buffer).
+  Mode m_mode;
+  bool m_bulkEndpointsReady;
+  bool m_bulkInBusy;
+  static constexpr uint16_t k_bulkPacketSize = 64;
+  uint8_t m_packetBuffer[k_bulkPacketSize];
+  // TmiaClient RX slot. Non-zero when a packet is pending consumption
+  // by the caller; the OUT endpoint stays un-armed until drained.
+  uint16_t m_rxPendingLen;
+
+  /* --- Descriptor tree (NumTube). A single vendor-class interface with two
+   * bulk endpoints: no operating system binds a driver to it, so libusb can
+   * talk to it directly; Windows gets the WinUSB driver automatically through
+   * the Microsoft OS 1.0 descriptors below. Members that point to each other
+   * are declared leaf first. */
+  EndpointDescriptor m_bulkInEndpoint;   // EP2 IN, bulk.
+  EndpointDescriptor m_bulkOutEndpoint;  // EP2 OUT, bulk; next = bulkIn.
+  InterfaceDescriptor m_dataInterface;   // interface 0, vendor class.
+  InterfaceDescriptor m_interfaces[1];
+  ConfigurationDescriptor m_configurationDescriptor;
+  DeviceDescriptor m_deviceDescriptor;
+  LanguageIDStringDescriptor m_languageStringDescriptor;
+  StringDescriptor m_manufacturerStringDescriptor;
+  StringDescriptor m_productStringDescriptor;
+  StringDescriptor m_serialNumberStringDescriptor;
+  MicrosoftOSStringDescriptor m_microsoftOSStringDescriptor;
+  ExtendedCompatIDDescriptor m_extendedCompatIdDescriptor;
+  // Descriptor lookup table (populated in ctor body).
+  DescriptorList m_descriptors;
+};
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
