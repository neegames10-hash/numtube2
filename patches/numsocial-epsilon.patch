+#pragma once
+
+#include <stdint.h>
+
+#include "link.h"
+#include "tile_decoder.h"
+
+namespace Numtube {
+
+// Full-screen playback loop. Blocks until the video ends or the user leaves.
+class Player {
+ public:
+  explicit Player(Link* link);
+
+  enum class Exit { Finished, Stopped, Error, Disconnected };
+  Exit play(const char* videoId);
+  const char* errorMessage() const { return m_error; }
+
+  // TileDecoder's blitter interface.
+  void push(int x, int y, int width, const uint16_t* pixels);
+
+ private:
+  static constexpr int k_barY = 180;
+  static constexpr int k_barHeight = 2;
+  static constexpr int k_stripY = 182;
+  static constexpr int k_stripHeight = 58;
+  static constexpr int k_textCapacity = 208;
+  static constexpr int k_statusCapacity = 48;
+
+  void sendControl(uint8_t command);
+  void sendSeek(int32_t deltaMs);
+  bool handleKey(Ion::Keyboard::Key key, Exit* exit);
+  bool handleFrame(uint8_t type, const uint8_t* payload, uint16_t length,
+                   Exit* exit);
+  void clearScreen();
+  void drawStrip();
+  void drawProgress(uint32_t positionMs);
+  void copyText(char* destination, int capacity, const uint8_t* source,
+                uint16_t length);
+
+  Link* m_link;
+  TileDecoder<Player> m_decoder;
+  uint16_t m_rowBuffer[TileDecoder<Player>::k_rowBufferPixels];
+  uint32_t m_durationMs;
+  int m_progressX;
+  uint32_t m_framesShown;
+  bool m_started;
+  bool m_paused;
+  bool m_stripDirty;
+  bool m_hasSubtitles;
+  char m_subtitle[k_textCapacity];
+  char m_status[k_statusCapacity];
+  char m_error[k_statusCapacity * 2];
+};
+
+}  // namespace Numtube
diff --git a/epsilon/apps/numtube/protocol.h b/epsilon/apps/numtube/protocol.h
new file mode 100644
index 0000000000..6235f6a1e8
--- /dev/null
+++ b/epsilon/apps/numtube/protocol.h
@@ -0,0 +1,35 @@
+#pragma once
+
+#include <stdint.h>
+
+// Frame types carried in TMIA frames between the calculator and the gateway.
+// Keep in sync with gateway/numtube_gateway.py.
+namespace Numtube {
+namespace Protocol {
+
+enum Type : uint8_t {
+  Error = 0x07,
+  Hello = 0x0A,
+  HelloAck = 0x0B,
+  Search = 0x40,      // PC <- calc: UTF-8 query
+  Result = 0x41,      // PC -> calc: one search result
+  SearchDone = 0x42,  // PC -> calc: u8 count
+  Play = 0x43,        // PC <- calc: u32 start_ms, ASCII video id
+  PlayInfo = 0x44,    // PC -> calc: u32 duration_ms, u8 fps, u8 has_subs, title
+  Video = 0x45,  // PC -> calc: u16 frame, u32 pts_ms, u16 start_tile, u8 flags,
+                 // tile ops
+  Subtitle = 0x46,  // PC -> calc: UTF-8 lines separated by '\n', may be empty
+  Ack = 0x47,       // PC <- calc: u16 frame
+  Control = 0x48,   // PC <- calc: u8 command, optional i32 seek delta in ms
+  PlayEnd = 0x49,   // PC -> calc: u8 reason (0 = end of the video)
+  Status = 0x4A,    // PC -> calc: UTF-8 progress message, empty to clear
+  Log = 0x4B,       // PC <- calc: diagnostic text, printed by the gateway
+};
+
+enum Command : uint8_t { Stop = 0, Pause = 1, Resume = 2, Seek = 3 };
+
+constexpr uint8_t k_videoFlagEndOfFrame = 1;
+constexpr uint16_t k_videoHeaderLength = 9;
+
+}  // namespace Protocol
+}  // namespace Numtube
diff --git a/epsilon/apps/numtube/tile_decoder.h b/epsilon/apps/numtube/tile_decoder.h
new file mode 100644
index 0000000000..9802c52915
--- /dev/null
+++ b/epsilon/apps/numtube/tile_decoder.h
@@ -0,0 +1,146 @@
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+// Decoder for the NumTube tile stream (see gateway/numtube_gateway.py).
+//
+// This header has no firmware dependency so that the exact same code is
+// exercised by the desktop test harness (tests/decode_harness.cpp).
+//
+// Pixels go straight to a Blitter, row of tiles by row of tiles, so the
+// calculator never needs a 115 KB frame buffer.
+
+namespace Numtube {
+
+constexpr int k_videoWidth = 320;
+constexpr int k_videoHeight = 180;
+constexpr int k_tileSize = 4;
+constexpr int k_tileCols = k_videoWidth / k_tileSize;
+constexpr int k_tileRows = k_videoHeight / k_tileSize;
+constexpr int k_tileCount = k_tileCols * k_tileRows;
+
+// Rows: rows of 4x4 tiles (45 for NumTube's 320x180 video, 50 for NumScreen's
+// 320x200 picture of the computer screen).
+template <typename Blitter, int Rows = k_tileRows>
+class TileDecoder {
+ public:
+  TileDecoder(uint16_t* rowBuffer, Blitter* blitter)
+      : m_row(rowBuffer), m_blitter(blitter) {}
+
+  // Row buffer: 4 lines of k_videoWidth RGB565 pixels.
+  static constexpr size_t k_rowBufferPixels = k_videoWidth * k_tileSize;
+  static constexpr int k_count = Rows * k_tileCols;
+
+  // Decodes one chunk. Malformed input stops at the point of the error and
+  // can never write outside the picture.
+  void decode(uint16_t startTile, const uint8_t* ops, size_t length) {
+    int tile = startTile;
+    size_t pos = 0;
+    m_spanStart = -1;
+    m_spanRow = -1;
+    while (pos < length && tile < k_count) {
+      const uint8_t op = ops[pos++];
+      const int count = (op & 0x3F) + 1;
+      switch (op >> 6) {
+        case 0:
+          flush();
+          tile += count;
+          break;
+        case 1: {
+          if (pos + 2 > length) {
+            flush();
+            return;
+          }
+          const uint16_t color = read16(ops + pos);
+          pos += 2;
+          for (int i = 0; i < count && tile < k_count; i++) {
+            uint16_t* row = beginTile(tile++);
+            for (int y = 0; y < k_tileSize; y++) {
+              uint16_t* out = row + y * k_videoWidth;
+              out[0] = out[1] = out[2] = out[3] = color;
+            }
+          }
+          break;
+        }
+        case 2:
+          for (int i = 0; i < count && tile < k_count; i++) {
+            if (pos + 8 > length) {
+              flush();
+              return;
+            }
+            decodeBlock(beginTile(tile++), ops + pos);
+            pos += 8;
+          }
+          break;
+        default:
+          flush();
+          return;
+      }
+    }
+    flush();
+  }
+
+ private:
+  static uint16_t read16(const uint8_t* p) {
+    return static_cast<uint16_t>(p[0] | (p[1] << 8));
+  }
+
+  // Returns where the tile's pixels go; opens or extends the dirty span.
+  uint16_t* beginTile(int tile) {
+    const int rowIndex = tile / k_tileCols;
+    const int column = tile % k_tileCols;
+    if (rowIndex != m_spanRow || column != m_spanEnd) {
+      flush();
+      m_spanRow = rowIndex;
+      m_spanStart = column;
+    }
+    m_spanEnd = column + 1;
+    return m_row + column * k_tileSize;
+  }
+
+  void flush() {
+    if (m_spanStart < 0) {
+      return;
+    }
+    const int x = m_spanStart * k_tileSize;
+    const int width = (m_spanEnd - m_spanStart) * k_tileSize;
+    for (int y = 0; y < k_tileSize; y++) {
+      m_blitter->push(x, m_spanRow * k_tileSize + y, width,
+                      m_row + y * k_videoWidth + x);
+    }
+    m_spanStart = -1;
+    m_spanRow = -1;
+  }
+
+  static void decodeBlock(uint16_t* out, const uint8_t* data) {
+    const uint16_t c0 = read16(data);
+    const uint16_t c1 = read16(data + 2);
+    const int r0 = c0 >> 11, g0 = (c0 >> 5) & 63, b0 = c0 & 31;
+    const int r1 = c1 >> 11, g1 = (c1 >> 5) & 63, b1 = c1 & 31;
+    const uint16_t palette[4] = {
+        c0,
+        c1,
+        static_cast<uint16_t>((((2 * r0 + r1) / 3) << 11) |
+                              (((2 * g0 + g1) / 3) << 5) | ((2 * b0 + b1) / 3)),
+        static_cast<uint16_t>((((r0 + 2 * r1) / 3) << 11) |
+                              (((g0 + 2 * g1) / 3) << 5) | ((b0 + 2 * b1) / 3)),
+    };
+    for (int y = 0; y < k_tileSize; y++) {
+      const uint8_t bits = data[4 + y];
+      uint16_t* line = out + y * k_videoWidth;
+      line[0] = palette[bits & 3];
+      line[1] = palette[(bits >> 2) & 3];
+      line[2] = palette[(bits >> 4) & 3];
+      line[3] = palette[(bits >> 6) & 3];
+    }
+  }
+
+  uint16_t* m_row;
+  Blitter* m_blitter;
+  int m_spanRow = -1;
+  int m_spanStart = -1;
+  int m_spanEnd = 0;
+};
+
+}  // namespace Numtube
