+#include "termia_bridge.h"
+
+#include <shared/regs/otg.h>
+#include <string.h>
+
+namespace Ion {
+namespace Device {
+namespace USB {
+
+using namespace Regs;
+
+/* Distinct PID from the DFU mode (Config::PID = 0xA291) so `lsusb` and
+ * udev rules can tell the two modes apart on sight. Same STMicro VID
+ * (0x0483) as Calculator — the bridge daemon only checks VID. */
+static constexpr uint16_t k_termiaBridgePID = 0xA292;
+static constexpr uint16_t k_termiaBridgeBCD = 0x0100;  // Termia USB iface v1.0
+
+static constexpr uint16_t k_configurationTotalLength =
+    ConfigurationDescriptor::BLength() + InterfaceDescriptor::BLength() +
+    2 * EndpointDescriptor::BLength();
+// Same vendor code as the DFU device (calculator.h).
+static constexpr uint8_t k_microsoftOSVendorCode = 2;
+
+TermiaBridge::TermiaBridge(const char* serialNumber)
+    : Device(&m_cdcInterface),
+      m_cdcInterface(&m_ep0),
+      m_bulkInEndpoint(k_cdcBulkInEndpoint, 0x02 /* bulk */,
+                       k_cdcBulkMaxPacketSize, 0),
+      m_bulkOutEndpoint(k_cdcBulkOutEndpoint, 0x02, k_cdcBulkMaxPacketSize, 0,
+                        &m_bulkInEndpoint),
+      m_dataInterface(0,     // bInterfaceNumber
+                      0,     // bAlternateSetting
+                      2,     // bNumEndpoints
+                      0xFF,  // vendor class
+                      0x00, 0x00, 0, &m_bulkOutEndpoint),
+      m_interfaces{m_dataInterface},
+      m_configurationDescriptor(k_configurationTotalLength,
+                                1,  // bNumInterfaces
+                                k_bConfigurationValue, 0,
+                                0x80,  // bus-powered
+                                0x32,  // 100 mA
+                                m_interfaces),
+      m_deviceDescriptor(0x0200,  // USB 2.0 (no BOS needed)
+                         0x00, 0x00, 0x00,  // class defined by the interface
+                         64, 0x0483, k_termiaBridgePID, k_termiaBridgeBCD,
+                         1, 2, 3, 1),
+      m_manufacturerStringDescriptor("NumWorks"),
+      m_productStringDescriptor("NumWorks NumTube"),
+      m_serialNumberStringDescriptor(serialNumber),
+      m_microsoftOSStringDescriptor(k_microsoftOSVendorCode),
+      m_extendedCompatIdDescriptor("WINUSB"),
+      m_descriptors{makeDescriptorList(
+          &m_deviceDescriptor,              // type = Device, index = 0
+          &m_configurationDescriptor,       // type = Configuration, index = 0
+          &m_languageStringDescriptor,      // type = String, index = 0
+          &m_manufacturerStringDescriptor,  // type = String, index = 1
+          &m_productStringDescriptor,       // type = String, index = 2
+          &m_serialNumberStringDescriptor   // type = String, index = 3
+          )} {
+  m_mode = Mode::Disabled;
+  m_bulkEndpointsReady = false;
+  m_bulkInBusy = false;
+  m_rxPendingLen = 0;
+}
+
+// ---------------------------------------------------------------------------
+// TMIA wire-protocol helpers — subset of the app-layer codec in
+// apps/termia/tmia/tmia.cpp. Duplicated here to keep the driver layer
+// free of app-code dependencies. Constants stay in sync with
+// bridge/crates/termia-protocol/src/lib.rs and apps/termia/tmia/tmia.h.
+// ---------------------------------------------------------------------------
+namespace {
+
+constexpr uint8_t k_tmiaMagic[4] = {'T', 'M', 'I', 'A'};
+constexpr uint8_t k_tmiaVersion = 1;
+constexpr size_t k_tmiaHeaderLen = 8;
+constexpr size_t k_tmiaCrcLen = 2;
+constexpr uint8_t k_tmiaTypePing = 0x08;
+constexpr uint8_t k_tmiaTypePong = 0x09;
+
+// CRC-16/CCITT-FALSE: poly 0x1021, init 0xFFFF, no reflect, xor-out 0.
+uint16_t tmiaCrc16(const uint8_t* data, size_t len) {
+  uint16_t crc = 0xFFFF;
+  for (size_t i = 0; i < len; i++) {
+    crc ^= static_cast<uint16_t>(data[i]) << 8;
+    for (int b = 0; b < 8; b++) {
+      crc = (crc & 0x8000) ? static_cast<uint16_t>((crc << 1) ^ 0x1021)
+                           : static_cast<uint16_t>(crc << 1);
+    }
+  }
+  return crc;
+}
+
+/* Decode just enough of `bytes` to identify a PING frame and extract
+ * its payload. Returns true if `bytes` is a well-formed PING (magic,
+ * version, CRC all pass). Writes the payload offset + length via
+ * out-params. */
+bool tmiaTryDecodePing(const uint8_t* bytes, size_t bytesLen,
+                       size_t* outPayloadOffset, size_t* outPayloadLen) {
+  if (bytesLen < k_tmiaHeaderLen + k_tmiaCrcLen) return false;
+  for (int i = 0; i < 4; i++) {
+    if (bytes[i] != k_tmiaMagic[i]) return false;
+  }
+  if (bytes[4] != k_tmiaVersion) return false;
+  if (bytes[5] != k_tmiaTypePing) return false;
+  size_t len =
+      static_cast<size_t>(bytes[6]) | (static_cast<size_t>(bytes[7]) << 8);
+  if (k_tmiaHeaderLen + len + k_tmiaCrcLen > bytesLen) return false;
+  uint16_t expected = tmiaCrc16(bytes, k_tmiaHeaderLen + len);
+  uint16_t actual =
+      static_cast<uint16_t>(bytes[k_tmiaHeaderLen + len]) |
+      (static_cast<uint16_t>(bytes[k_tmiaHeaderLen + len + 1]) << 8);
+  if (expected != actual) return false;
+  *outPayloadOffset = k_tmiaHeaderLen;
+  *outPayloadLen = len;
+  return true;
+}
+
+/* Write a PONG frame into `out`. Returns the byte count (always
+ * k_tmiaHeaderLen + payloadLen + k_tmiaCrcLen) or 0 if `outCap` is
+ * too small. */
+size_t tmiaEncodePong(const uint8_t* payload, size_t payloadLen, uint8_t* out,
+                      size_t outCap) {
+  size_t total = k_tmiaHeaderLen + payloadLen + k_tmiaCrcLen;
+  if (outCap < total) return 0;
+  out[0] = 'T';
+  out[1] = 'M';
+  out[2] = 'I';
+  out[3] = 'A';
+  out[4] = k_tmiaVersion;
+  out[5] = k_tmiaTypePong;
+  out[6] = static_cast<uint8_t>(payloadLen & 0xFF);
+  out[7] = static_cast<uint8_t>((payloadLen >> 8) & 0xFF);
+  for (size_t i = 0; i < payloadLen; i++) {
+    out[k_tmiaHeaderLen + i] = payload[i];
+  }
+  uint16_t crc = tmiaCrc16(out, k_tmiaHeaderLen + payloadLen);
+  out[k_tmiaHeaderLen + payloadLen] = static_cast<uint8_t>(crc & 0xFF);
+  out[k_tmiaHeaderLen + payloadLen + 1] =
+      static_cast<uint8_t>((crc >> 8) & 0xFF);
+  return total;
+}
+
+}  // namespace
+
+// Runtime behaviour ---------------------------------------------------------
+
+void TermiaBridge::setActiveConfiguration(uint8_t configurationIndex) {
+  /* The host sends SET_CONFIGURATION with wValue=1 once enumeration is
+   * complete and it's ready to talk on our non-control endpoints.
+   * That's our cue to stand up the bulk endpoints. wValue=0 means
+   * "unconfigure" — tear down and wait for the next config. */
+  if (configurationIndex == k_bConfigurationValue) {
+    initBulkEndpoints();
+    m_bulkEndpointsReady = true;
+  } else {
+    m_bulkEndpointsReady = false;
+  }
+}
+
+void TermiaBridge::initBulkEndpoints() {
+  /* TX FIFO allocation. EP0 TX starts at word 128 with depth 16
+   * (see endpoint0_otg.cpp:55-59). We allocate the next two slots
+   * for EPs 1 and 2 IN. Layout:
+   *   RX shared       : words   0..127 (512 B)
+   *   EP0 IN TX FIFO  : words 128..143  (64 B)  — FIFO #0
+   *   EP1 IN TX FIFO  : words 144..159  (64 B)  — FIFO #1 (notification, unused)
+   *   EP2 IN TX FIFO  : words 160..175  (64 B)  — FIFO #2 (bulk IN) */
+  OTG::DIEPTXFx tx1(0);
+  tx1.setINEPTXSA(144);
+  tx1.setINEPTXFD(16);
+  OTG.DIEPTXF(1)->set(tx1);
+
+  OTG::DIEPTXFx tx2(0);
+  tx2.setINEPTXSA(160);
+  tx2.setINEPTXFD(16);
+  OTG.DIEPTXF(2)->set(tx2);
+
+  /* Bulk IN endpoint (EP2 IN, bEndpointAddress 0x82).
+   * Bulk type (EPTYP=2), 64-byte packets, uses TX FIFO #2, starts
+   * active and NAKing (SNAK=1) until bulkTransmit arms a packet. */
+  OTG::DIEPCTLx diepctl(0);
+  diepctl.setMPSIZ(k_bulkPacketSize);
+  diepctl.setUSBAEP(true);
+  diepctl.setEPTYP(2);
+  diepctl.setTXFNUM(2);
+  diepctl.setSNAK(true);
+  diepctl.setSD0PID(true);
+  OTG.DIEPCTL(k_bulkInEpNum)->set(diepctl);
+
+  /* Bulk OUT endpoint (EP2 OUT, bEndpointAddress 0x02). */
+  OTG::DOEPCTLx doepctl(0);
+  doepctl.setMPSIZ(k_bulkPacketSize);
+  doepctl.setUSBAEP(true);
+  doepctl.setEPTYP(2);
+  doepctl.setSD0PID(true);
+  OTG.DOEPCTL(k_bulkOutEpNum)->set(doepctl);
+
+  /* Unmask transfer-complete interrupts for EP1 IN and EP2 IN on the
+   * IEPM side (bit = endpoint number), and EP2 OUT on the OEPM side.
+   * Default DIEPMSK already has XFRCM (transfer-complete) enabled per
+   * the existing enumeration path — we piggy-back on that. */
+  uint32_t aintmsk = OTG.DAINTMSK()->get();
+  aintmsk |= (1u << k_bulkInEpNum);                 // IEPM bit N
+  aintmsk |= (1u << (16 + k_bulkOutEpNum));         // OEPM bit N
+  OTG.DAINTMSK()->set(aintmsk);
+
+  armBulkOutReceive();
+  m_bulkInBusy = false;
+}
+
+void TermiaBridge::armBulkOutReceive() {
+  /* Tell the controller we'll accept one bulk OUT packet of up to
+   * k_bulkPacketSize bytes. PKTCNT=1, XFRSIZ=64. After EPENA+CNAK
+   * the hardware will ACK the next OUT packet from the host and
+   * deliver it via the shared RX FIFO with GRXSTSP.EPNUM = 2. */
+  OTG::DOEPTSIZx tsiz(0);
+  tsiz.setPKTCNT(1);
+  tsiz.setXFRSIZ(k_bulkPacketSize);
+  OTG.DOEPTSIZ(k_bulkOutEpNum)->set(tsiz);
+  OTG.DOEPCTL(k_bulkOutEpNum)->setEPENA(true);
+  OTG.DOEPCTL(k_bulkOutEpNum)->setCNAK(true);
+}
+
+bool TermiaBridge::bulkTransmit(const uint8_t* data, uint16_t len) {
+  if (!m_bulkEndpointsReady || len > k_bulkPacketSize) {
+    return false;
+  }
+  // Wait for any prior in-flight TX to drain. This should finish
+  // within a handful of USB microframes.
+  while (m_bulkInBusy) {
+    /* Transfer-complete interrupts are serviced by Device::poll(),
+     * which clears m_bulkInBusy via handleBulkInComplete. We're
+     * inside the same poll context, so no busy-loop is needed —
+     * if bulkTransmit is called from handleBulkOutPacket we know
+     * the EP is idle because we just finished a receive. Sanity
+     * break: return false if still busy. */
+    return false;
+  }
+  // Program the transfer: one packet, `len` bytes.
+  OTG::DIEPTSIZx tsiz(0);
+  tsiz.setPKTCNT(1);
+  tsiz.setXFRSIZ(len);
+  OTG.DIEPTSIZ(k_bulkInEpNum)->set(tsiz);
+  // Enable the endpoint and clear NAK so the core starts streaming.
+  OTG.DIEPCTL(k_bulkInEpNum)->setEPENA(true);
+  OTG.DIEPCTL(k_bulkInEpNum)->setCNAK(true);
+  // Push the payload into the per-EP TX FIFO, 32 bits at a time.
+  volatile auto* fifo = OTG.DFIFO(k_bulkInEpNum);
+  uint16_t full = len & ~uint16_t(3);
+  const uint32_t* words = reinterpret_cast<const uint32_t*>(data);
+  for (uint16_t i = 0; i < full; i += 4) {
+    fifo->set(*words++);
+  }
+  uint16_t tail = len - full;
+  if (tail) {
+    uint32_t last = 0;
+    memcpy(&last, data + full, tail);
+    fifo->set(last);
+  }
+  m_bulkInBusy = true;
+  return true;
+}
+
+void TermiaBridge::handleBulkOutPacket(uint8_t epNum, uint16_t byteCount) {
+  if (epNum != k_bulkOutEpNum) {
+    return;
+  }
+  // Read the packet out of the shared RX FIFO. The FIFO is popped
+  // 32 bits at a time; trailing bytes come out in the low portion of
+  // the final word.
+  volatile auto* fifo = OTG.DFIFO(0);  // shared RX FIFO register
+  uint16_t toRead = byteCount > k_bulkPacketSize ? k_bulkPacketSize : byteCount;
+  uint16_t readBytes = 0;
+  uint32_t* out32 = reinterpret_cast<uint32_t*>(m_packetBuffer);
+  while (readBytes + 4 <= toRead) {
+    *out32++ = fifo->get();
+    readBytes += 4;
+  }
+  if (readBytes < toRead) {
+    uint32_t extra = fifo->get();
+    memcpy(m_packetBuffer + readBytes, &extra, toRead - readBytes);
+    readBytes = toRead;
+  }
+  // Drain any unconsumed bytes from the FIFO for this packet (there
+  // shouldn't be any since we capped toRead at k_bulkPacketSize, but
+  // be defensive in case the host sent a short packet <=> byteCount).
+  uint16_t unread = byteCount > toRead ? byteCount - toRead : 0;
+  for (uint16_t i = 0; i < unread; i += 4) {
+    fifo->get();
+  }
+
+  if (readBytes == 0) {
+    armBulkOutReceive();
+    return;
+  }
+
+  switch (m_mode) {
+    case Mode::Raw:
+      bulkTransmit(m_packetBuffer, readBytes);
+      armBulkOutReceive();
+      break;
+    case Mode::TmiaServer: {
+      size_t payloadOff = 0, payloadLen = 0;
+      if (tmiaTryDecodePing(m_packetBuffer, readBytes, &payloadOff,
+                            &payloadLen)) {
+        uint8_t pongFrame[k_bulkPacketSize];
+        size_t n = tmiaEncodePong(m_packetBuffer + payloadOff, payloadLen,
+                                  pongFrame, sizeof(pongFrame));
+        if (n > 0) {
+          bulkTransmit(pongFrame, static_cast<uint16_t>(n));
+        }
+      }
+      /* Non-PING frames and malformed input are silently dropped.
+       * The bridge daemon's timeout will surface any stall to the
+       * host CLI. */
+      armBulkOutReceive();
+      break;
+    }
+    case Mode::TmiaClient:
+      /* Stash the packet for caller consumption; do NOT re-arm OUT
+       * — tryPopReceivedFrame handles that once the caller drains. */
+      m_rxPendingLen = readBytes;
+      break;
+    case Mode::Disabled:
+      armBulkOutReceive();
+      break;
+  }
+}
+
+bool TermiaBridge::sendFrame(const uint8_t* bytes, uint16_t len) {
+  if (!m_bulkEndpointsReady || len == 0) {
+    return false;
+  }
+  /* Split the frame into USB bulk packets (64 B max on full speed).
+   * Wait for the prior TX to drain between packets — the hardware
+   * FIFO is only 64 bytes deep, so we can't queue more than one.
+   * The naturally-short final packet (< 64 B) signals end-of-transfer
+   * to the host's cdc_acm driver; for frames that happen to be an
+   * exact multiple of 64 B, we send an extra zero-length packet. */
+  uint16_t offset = 0;
+  while (offset < len) {
+    uint16_t chunk = len - offset;
+    if (chunk > k_bulkPacketSize) {
+      chunk = k_bulkPacketSize;
+    }
+    while (m_bulkInBusy) {
+      poll();
+    }
+    if (!bulkTransmit(bytes + offset, chunk)) {
+      return false;
+    }
+    offset += chunk;
+  }
+  if (len > 0 && (len % k_bulkPacketSize) == 0) {
+    while (m_bulkInBusy) {
+      poll();
+    }
+    bulkTransmit(bytes, 0);  // zero-length packet
+  }
+  return true;
+}
+
+bool TermiaBridge::tryPopReceivedFrame(uint8_t* buf, uint16_t bufCap,
+                                       uint16_t* outLen) {
+  if (m_rxPendingLen == 0) {
+    return false;
+  }
+  uint16_t n = m_rxPendingLen > bufCap ? bufCap : m_rxPendingLen;
+  memcpy(buf, m_packetBuffer, n);
+  *outLen = n;
+  m_rxPendingLen = 0;
+  armBulkOutReceive();
+  return true;
+}
+
+void TermiaBridge::clearEndpointHalt(uint8_t endpointAddress) {
+  if (endpointAddress == k_cdcBulkInEndpoint) {
+    OTG.DIEPCTL(k_bulkInEpNum)->setSD0PID(true);
+  } else if (endpointAddress == k_cdcBulkOutEndpoint) {
+    OTG.DOEPCTL(k_bulkOutEpNum)->setSD0PID(true);
+  }
+}
+
+void TermiaBridge::handleBulkInComplete(uint8_t epNum) {
+  if (epNum == k_bulkInEpNum) {
+    m_bulkInBusy = false;
+  }
+}
+
+bool TermiaBridge::processSetupInRequest(SetupPacket* request,
+                                         uint8_t* transferBuffer,
+                                         uint16_t* transferBufferLength,
+                                         uint16_t transferBufferMaxLength) {
+  if (Device::processSetupInRequest(request, transferBuffer,
+                                    transferBufferLength,
+                                    transferBufferMaxLength)) {
+    return true;
+  }
+  // Windows asks which driver to use (Microsoft OS 1.0, Extended Compat ID).
+  if (request->requestType() == SetupPacket::RequestType::Vendor &&
+      request->bRequest() == k_microsoftOSVendorCode &&
+      request->wIndex() == ExtendedCompatIDDescriptor::Index) {
+    *transferBufferLength = m_extendedCompatIdDescriptor.copy(
+        transferBuffer, transferBufferMaxLength);
+    return true;
+  }
+  return false;
+}
+
+Descriptor* TermiaBridge::descriptor(uint8_t type, uint8_t index) {
+  if (type == m_microsoftOSStringDescriptor.type() && index == 0xEE) {
+    return &m_microsoftOSStringDescriptor;
+  }
+  int typeCount = 0;
+  for (Descriptor* d : m_descriptors) {
+    if (d->type() != type) {
+      continue;
+    }
+    if (typeCount == index) {
+      return d;
+    }
+    typeCount++;
+  }
+  return nullptr;
+}
+
+}  // namespace USB
+}  // namespace Device
+}  // namespace Ion
